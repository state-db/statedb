<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.statedb</groupId>
        <artifactId>state-db-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>state-db-app</artifactId>

    <properties>
        <!-- Set true by the image build, whose Maven stage has no bun and supplies ../web/dist. -->
        <web.build.skip>false</web.build.skip>
        <!-- Filtered into build-info.properties, served at /api/version. -->
        <statedb.build.version>unknown</statedb.build.version>
        <statedb.build.commit>unknown</statedb.build.commit>
        <statedb.build.timestamp>unknown</statedb.build.timestamp>
    </properties>

    <dependencies>
        <dependency>
            <groupId>app.statedb</groupId>
            <artifactId>state-db-persistence</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>app.statedb</groupId>
            <artifactId>state-db-pulumi-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>app.statedb</groupId>
            <artifactId>state-db-console-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-config-yaml</artifactId>
        </dependency>

        <!-- Probes and Prometheus scrape, served on the management interface. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>app.statedb</groupId>
            <artifactId>state-db-test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-JVM mock OIDC provider (WireMock-backed) for the console code-flow tests. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-oidc-server</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Only build-info.properties is filtered; application.yml's ${...} must stay runtime
             config expressions, not Maven properties. -->
        <resources>
            <resource>
                <filtering>true</filtering>
                <directory>src/main/resources</directory>
                <includes>
                    <include>build-info.properties</include>
                </includes>
            </resource>
            <resource>
                <filtering>false</filtering>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>build-info.properties</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Web console build. The SPA lives in ../web (a standalone bun
              project, not a Maven module). These executions run at
              prepare-package so `mvn package` embeds the bundle but `quarkus:dev`
              and `mvn test` stay fast (neither runs prepare-package). For local
              SPA work, run the bun dev server instead (`make web-dev`).
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!-- Frozen install: fail the build if bun.lock and
                         package.json disagree, rather than silently re-resolving
                         dependencies. Keeps packaged artifacts reproducible. -->
                    <execution>
                        <id>web-install</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <skip>${web.build.skip}</skip>
                            <executable>bun</executable>
                            <workingDirectory>${project.basedir}/../web</workingDirectory>
                            <arguments>
                                <argument>install</argument>
                                <argument>--frozen-lockfile</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Typecheck before bundling. bun build transpiles without
                         checking types, so without this a type error would ship. -->
                    <execution>
                        <id>web-typecheck</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <skip>${web.build.skip}</skip>
                            <executable>bun</executable>
                            <workingDirectory>${project.basedir}/../web</workingDirectory>
                            <arguments>
                                <argument>run</argument>
                                <argument>typecheck</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>web-build</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <skip>${web.build.skip}</skip>
                            <executable>bun</executable>
                            <workingDirectory>${project.basedir}/../web</workingDirectory>
                            <arguments>
                                <argument>run</argument>
                                <argument>build</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Copy the bun build output into the app's classpath under
              META-INF/resources, which Quarkus serves as static assets. Runs
              after the exec executions above (same phase, declared later) so
              ../web/dist exists. Targets build output, never the source tree.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-web-bundle</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../web/dist</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <!-- Third-party attribution file, served at
                         /THIRD-PARTY-NOTICES.txt and linked from the console
                         footer. Regenerated by `make notices`; CI fails if it
                         goes stale. -->
                    <execution>
                        <id>copy-third-party-notices</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../..</directory>
                                    <includes>
                                        <include>THIRD-PARTY-NOTICES.txt</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
