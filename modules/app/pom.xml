<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.statedb</groupId>
        <artifactId>state-db-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>state-db-app</artifactId>

    <properties>
        <!-- Set true by the image build, whose Maven stage has no bun and supplies ../web/dist. -->
        <web.build.skip>false</web.build.skip>
        <!-- Filtered into build-info.properties, served at /api/version. -->
        <statedb.build.version>unknown</statedb.build.version>
        <statedb.build.commit>unknown</statedb.build.commit>
        <statedb.build.timestamp>unknown</statedb.build.timestamp>
    </properties>

    <dependencies>
        <dependency>
            <groupId>app.statedb</groupId>
            <artifactId>state-db-persistence</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>app.statedb</groupId>
            <artifactId>state-db-pulumi-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>app.statedb</groupId>
            <artifactId>state-db-console-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-config-yaml</artifactId>
        </dependency>

        <!-- Probes and Prometheus scrape, served on the management interface. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>app.statedb</groupId>
            <artifactId>state-db-test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-JVM mock OIDC provider (WireMock-backed) for the console code-flow tests. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-oidc-server</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Only build-info.properties is filtered; application.yml's ${...} must stay runtime
             config expressions, not Maven properties. -->
        <resources>
            <resource>
                <filtering>true</filtering>
                <directory>src/main/resources</directory>
                <includes>
                    <include>build-info.properties</include>
                </includes>
            </resource>
            <resource>
                <filtering>false</filtering>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>build-info.properties</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Web console build. The SPA lives in ../web (a standalone bun
              project, not a Maven module). These executions run at
              prepare-package so `mvn package` embeds the bundle but `quarkus:dev`
              and `mvn test` stay fast (neither runs prepare-package). For local
              SPA work, use the hot-reload workbench (`make pulumi-workbench cmd=app-dev`).
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <!-- Frozen install: fail the build if bun.lock and
                         package.json disagree, rather than silently re-resolving
                         dependencies. Keeps packaged artifacts reproducible. -->
                    <execution>
                        <id>web-install</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <skip>${web.build.skip}</skip>
                            <executable>bun</executable>
                            <workingDirectory>${project.basedir}/../web</workingDirectory>
                            <arguments>
                                <argument>install</argument>
                                <argument>--frozen-lockfile</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Typecheck before bundling. bun build transpiles without
                         checking types, so without this a type error would ship. -->
                    <execution>
                        <id>web-typecheck</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <skip>${web.build.skip}</skip>
                            <executable>bun</executable>
                            <workingDirectory>${project.basedir}/../web</workingDirectory>
                            <arguments>
                                <argument>run</argument>
                                <argument>typecheck</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>web-build</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <skip>${web.build.skip}</skip>
                            <executable>bun</executable>
                            <workingDirectory>${project.basedir}/../web</workingDirectory>
                            <arguments>
                                <argument>run</argument>
                                <argument>build</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Copy the bun build output into the app's classpath under
              META-INF/resources, which Quarkus serves as static assets. Runs
              after the exec executions above (same phase, declared later) so
              ../web/dist exists. Targets build output, never the source tree.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>copy-web-bundle</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../web/dist</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <!-- Third-party attribution file, served at
                         /THIRD-PARTY-NOTICES.txt and linked from the console
                         footer. Regenerated by `./dev notices`; CI fails if it
                         goes stale. -->
                    <execution>
                        <id>copy-third-party-notices</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../..</directory>
                                    <includes>
                                        <include>THIRD-PARTY-NOTICES.txt</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>linux-cedar-jni-test-preload</id>
            <activation>
                <os>
                    <name>Linux</name>
                </os>
            </activation>
            <build>
                <plugins>
                    <!--
                      Cedar's Linux JNI library uses static TLS. The glibc loader can reject a
                      late dlopen after Quarkus/Testcontainers have loaded other native libraries,
                      especially on aarch64. Preload the exact cedar-java native library into each
                      forked test JVM and point Cedar's loader at that path. Quarkus tests create
                      multiple application classloaders, and Cedar's System.load(path) is not
                      cross-classloader idempotent, so Linux test forks cannot be reused safely.
                    -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>prepare-cedar-jni-test-lib</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <phase>process-test-classes</phase>
                                <configuration>
                                    <executable>${maven.multiModuleProjectDirectory}/../bin/prepare-cedar-jni-test-lib</executable>
                                    <arguments>
                                        <argument>${project.build.directory}/cedar-jni</argument>
                                        <argument>${settings.localRepository}/com/cedarpolicy/cedar-java/${cedar-java.version}/cedar-java-${cedar-java.version}-uber.jar</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven-failsafe-plugin.version}</version>
                        <configuration>
                            <reuseForks>false</reuseForks>
                            <environmentVariables>
                                <CEDAR_JAVA_FFI_LIB>${project.build.directory}/cedar-jni/libcedar_java_ffi.so</CEDAR_JAVA_FFI_LIB>
                                <LD_PRELOAD>${project.build.directory}/cedar-jni/libcedar_java_ffi.so</LD_PRELOAD>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native-agent-tests</id>
            <properties>
                <native.agent.java>/tmp/state-db-native-agent-mandrel/bin/java</native.agent.java>
            </properties>
            <build>
                <plugins>
                    <!-- Re-run the focused authorization and AWS credential-boundary tests inside the same
                         pinned Mandrel JVM used by the native build, and observe their dynamic
                         reachability. They exercise every Cedar call path, which is the reachability
                         Quarkus cannot derive at build time; everything else in the suite resolves to
                         entities, REST payloads, and the source-local RDS signer path. The default
                         Surefire execution above still runs the comprehensive suite on the
                         mise-pinned Temurin JDK. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven-failsafe-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>native-agent-trace</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <phase>test</phase>
                                <configuration>
                                    <jvm>${native.agent.java}</jvm>
                                    <argLine>@{argLine} -agentlib:native-image-agent=config-merge-dir=${project.build.directory}/native-image-agent-base-config</argLine>
                                    <includes>
                                        <include>app/statedb/app/auth/*Test.java</include>
                                        <include>app/statedb/app/database/DatabaseCredentialsProviderTest.java</include>
                                    </includes>
                                    <reportsDirectory>${project.build.directory}/surefire-reports-native-agent</reportsDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Clear stale agent output before tracing, then diff the observations against
                         the reviewed baseline at verify. The reactor root is modules/, so the
                         repository bin directory is one level above it. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>prepare-native-metadata-test-run</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <phase>process-test-classes</phase>
                                <configuration>
                                    <executable>${maven.multiModuleProjectDirectory}/../bin/prepare-native-metadata-test-run</executable>
                                    <arguments>
                                        <argument>${project.build.directory}</argument>
                                        <argument>${native.agent.java}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>check-native-metadata-drift</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <phase>verify</phase>
                                <configuration>
                                    <executable>${maven.multiModuleProjectDirectory}/../bin/check-native-metadata-drift</executable>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
