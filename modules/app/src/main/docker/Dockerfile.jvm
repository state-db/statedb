# syntax=docker/dockerfile:1.19
#
#   make app-image

# ---- console bundle -------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM docker.io/oven/bun:1.3-alpine@sha256:5acc90a93e91ff07bf72aa90a7c9f0fa189765aec90b47bdbf2152d2196383c0 AS web

WORKDIR /web

COPY modules/web/package.json modules/web/bun.lock modules/web/bunfig.toml ./
RUN bun install --frozen-lockfile

COPY modules/web/ ./
RUN bun run typecheck && bun run build

# ---- application jar ------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM docker.io/library/maven:3.9-eclipse-temurin-21@sha256:c07f7ccfb8ca6c9fa29ee523f00afa7d2ca6132c92f8652c4aebb5ee3491f502 AS build

WORKDIR /src
COPY modules/ modules/
COPY THIRD-PARTY-NOTICES.txt ./

COPY --from=web /web/dist modules/web/dist

ARG BUILD_VERSION=unknown
ARG BUILD_COMMIT=unknown
ARG SOURCE_DATE_EPOCH=0

# Quarkus requires ISO-8601 here; Maven would also accept raw epoch seconds.
RUN --mount=type=cache,target=/root/.m2/repository,sharing=locked <<'EOF'
set -eu
built_at="$(date -u -d "@${SOURCE_DATE_EPOCH}" +%Y-%m-%dT%H:%M:%SZ)"
mvn -B -f modules/pom.xml -pl app -am package \
    -DskipTests \
    -Dweb.build.skip=true \
    -Dstatedb.build.version="${BUILD_VERSION}" \
    -Dstatedb.build.commit="${BUILD_COMMIT}" \
    -Dstatedb.build.timestamp="${built_at}" \
    -Dproject.build.outputTimestamp="${built_at}"
EOF

# ---- runtime --------------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24-3@sha256:f4519929e630051b1a207013ba81700898cf2c4605dfc3c85effc7c14b768e59

ARG BUILD_VERSION=unknown
ARG BUILD_COMMIT=unknown

LABEL org.opencontainers.image.title="state-db" \
      org.opencontainers.image.description="Self-hosted state backend for the Pulumi CLI, with a web console." \
      org.opencontainers.image.source="https://github.com/state-db/state-db" \
      org.opencontainers.image.licenses="Elastic-2.0" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.opencontainers.image.revision="${BUILD_COMMIT}"

# Owned 185:0 so it stays readable under arbitrary-uid policies.
COPY --from=build --chown=185:0 /src/modules/app/target/quarkus-app/lib/ /app/lib/
COPY --from=build --chown=185:0 /src/modules/app/target/quarkus-app/quarkus/ /app/quarkus/
COPY --from=build --chown=185:0 /src/modules/app/target/quarkus-app/app/ /app/app/
COPY --from=build --chown=185:0 /src/modules/app/target/quarkus-app/quarkus-run.jar /app/

USER 185

# 8080 Pulumi API and console; 9000 management.
EXPOSE 8080 9000

ENV JAVA_OPTS="-XX:+UseG1GC \
-XX:InitialRAMPercentage=75 -XX:MaxRAMPercentage=75 \
-XX:+AlwaysPreTouch \
-XX:+ExitOnOutOfMemoryError \
-XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp"

# Escape hatch for one-off diagnostics without changing the image baseline.
ENV JAVA_OPTS_APPEND=""

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS $JAVA_OPTS_APPEND -jar /app/quarkus-run.jar"]
