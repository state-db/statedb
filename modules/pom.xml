<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>app.statedb</groupId>
    <artifactId>state-db-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <licenses>
        <license>
            <name>AGPL-3.0-only</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>persistence</module>
        <module>vcs</module>
        <module>pulumi-api</module>
        <module>console-api</module>
        <module>app</module>
        <module>test-support</module>
        <module>pulumi-cli-smoke</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.40.1.2</quarkus.platform.version>
        <jandex-maven-plugin.version>3.6.1</jandex-maven-plugin.version>
        <license-maven-plugin.version>2.9.0</license-maven-plugin.version>
        <spotless-maven-plugin.version>3.11.0</spotless-maven-plugin.version>
        <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
        <findsecbugs-plugin.version>1.14.0</findsecbugs-plugin.version>
        <google-java-format.version>1.35.0</google-java-format.version>
        <skipTests>false</skipTests>
        <cedar-java.version>4.11.0</cedar-java.version>
        <tink.version>1.24.0</tink.version>
        <zstd-jni.version>1.5.7-6</zstd-jni.version>
        <jackson.version>2.23.0</jackson.version>
        <guava.version>33.8.0-jre</guava.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Patched ahead of the Quarkus BOM for HIGH CVEs that fail the release scan; drop once the BOM ships Jackson >= 2.22.3 and Guava >= 33.7.2. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                    <extensions>true</extensions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-maven-plugin.version}</version>
                </plugin>
                <!--
                  Third-party attribution for the shipped server. Not bound to a
                  lifecycle phase; `./dev notices` runs license:add-third-party on
                  the app module and folds the result into THIRD-PARTY-NOTICES.txt.
                  licenseMerges collapses the many spellings of the same license
                  so the generated listing groups correctly.
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>${license-maven-plugin.version}</version>
                    <configuration>
                        <excludedScopes>test,provided</excludedScopes>
                        <excludedGroups>app\.statedb</excludedGroups>
                        <failOnMissing>false</failOnMissing>
                        <sortArtifactByName>true</sortArtifactByName>
                        <!-- Resolves relative to the module the goal runs on;
                             `./dev notices` runs it on app only. -->
                        <overrideUrl>file:${project.basedir}/../third-party-license-overrides.properties</overrideUrl>
                        <licenseMerges>
                            <licenseMerge>Apache License 2.0|Apache-2.0|Apache 2.0|Apache 2|Apache License, Version 2.0|The Apache License, Version 2.0|The Apache Software License, Version 2.0|Apache Software License 2.0|Apache Software License, version 2.0|ASL 2.0|Apache License v2.0|Apache License version 2.0|Apache License Version 2.0</licenseMerge>
                            <licenseMerge>MIT License|MIT|The MIT License|The MIT License (MIT)|MIT license|MIT-0</licenseMerge>
                            <licenseMerge>BSD 3-Clause License|BSD-3-Clause|The BSD 3-Clause License|BSD License 3|New BSD License|BSD 3-clause New License|3-Clause BSD License|EDL 1.0|Eclipse Distribution License - v 1.0|Eclipse Distribution License v. 1.0</licenseMerge>
                            <licenseMerge>BSD 2-Clause License|BSD-2-Clause|The BSD 2-Clause License|BSD 2-Clause "Simplified" License</licenseMerge>
                            <licenseMerge>Eclipse Public License 2.0|EPL-2.0|EPL 2.0|Eclipse Public License v2.0|Eclipse Public License v. 2.0|Eclipse Public License - v 2.0|Eclipse Public License, Version 2.0</licenseMerge>
                            <licenseMerge>Eclipse Public License 1.0|EPL-1.0|EPL 1.0|Eclipse Public License v1.0|Eclipse Public License - v 1.0|Eclipse Public License, Version 1.0|Eclipse Public License 1.0 (EPL-1.0)</licenseMerge>
                            <licenseMerge>GNU Lesser General Public License 2.1|LGPL-2.1|LGPL, version 2.1|GNU Lesser General Public License, version 2.1|GNU Library General Public License v2.1 or later|LGPL 2.1</licenseMerge>
                            <licenseMerge>GNU General Public License v2.0 with Classpath Exception|GPL-2.0-with-classpath-exception|GPL2 w/ CPE|GNU General Public License, version 2 with the GNU Classpath Exception</licenseMerge>
                            <licenseMerge>Public Domain|Public domain|CC0|CC0-1.0|Creative Commons Zero|Public Domain, per Creative Commons CC0</licenseMerge>
                            <licenseMerge>Universal Permissive License 1.0|UPL-1.0|Universal Permissive License, Version 1.0</licenseMerge>
                        </licenseMerges>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              SpotBugs with the find-sec-bugs plugin: bytecode analysis for
              correctness bugs plus injection, path traversal and weak crypto.
              `mvn verify` fails on any finding, so both `./dev check` and CI
              enforce it. Suppressions go in spotbugs-exclude.xml.
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <includeTests>false</includeTests>
                    <!-- Resolves relative to each module; all modules are direct
                         children of modules/. -->
                    <excludeFilterFile>${project.basedir}/../spotbugs-exclude.xml</excludeFilterFile>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs-plugin.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <!--
              Spotless runs on every module (Java, pom.xml, YAML, Markdown).
              `mvn verify` calls `spotless:check` and fails on any unformatted
              file. The `spotless:apply` goal provides a focused formatting pass
              through the pinned development toolchain.
              Files outside modules/ (design/*.md, root README) rely on
              .editorconfig only — Spotless's project basedir is modules/.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>GOOGLE</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <importOrder/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                    <pom>
                        <includes>
                            <include>pom.xml</include>
                        </includes>
                        <sortPom>
                            <expandEmptyElements>false</expandEmptyElements>
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                        </sortPom>
                    </pom>
                    <formats>
                        <format>
                            <includes>
                                <include>src/main/resources/**/*.yml</include>
                                <include>src/main/resources/**/*.yaml</include>
                                <include>src/test/resources/**/*.yml</include>
                                <include>src/test/resources/**/*.yaml</include>
                                <include>**/*.md</include>
                            </includes>
                            <excludes>
                                <exclude>**/target/**</exclude>
                                <exclude>**/node_modules/**</exclude>
                            </excludes>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </format>
                    </formats>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
