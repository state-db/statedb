#!/usr/bin/env bash
# Generates the readable current-schema snapshot from the Flyway SQL chain.
set -euo pipefail

cd "$(dirname "$0")/.."
. bin/postgres-images

readonly PG_IMAGE=${STATEDB_SCHEMA_PG_IMAGE:-$STATEDB_POSTGRES_17_IMAGE}
readonly PULL_TIMEOUT_SECONDS=${STATEDB_SCHEMA_PULL_TIMEOUT_SECONDS:-300}
readonly DB_NAME=statedb_schema
readonly DB_USER=statedb_schema
readonly DB_PASSWORD=statedb_schema
readonly CONTAINER=state-db-schema-$$-$RANDOM
readonly OUTPUT=${STATEDB_SCHEMA_OUTPUT:-design/schema.sql}
readonly MIGRATION_DIR=${STATEDB_MIGRATION_DIR:-modules/persistence/src/main/resources/db/migration}

mode=write
case ${1:-} in
"") ;;
--check) mode=check ;;
*)
  echo "usage: bin/generate-db-schema [--check]" >&2
  exit 2
  ;;
esac

cleanup() {
  if [[ -n ${pull_pid:-} ]]; then
    kill "$pull_pid" >/dev/null 2>&1 || true
    wait "$pull_pid" >/dev/null 2>&1 || true
  fi
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  rm -rf "$work_dir"
}

work_dir=$(mktemp -d)
trap 'rc=$?; cleanup; exit "$rc"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
generated="$work_dir/schema.sql"
pull_pid=

[[ $PULL_TIMEOUT_SECONDS =~ ^[1-9][0-9]*$ ]] || {
  echo "generate-db-schema: STATEDB_SCHEMA_PULL_TIMEOUT_SECONDS must be a positive integer" >&2
  exit 2
}

if ! docker image inspect "$PG_IMAGE" >/dev/null 2>&1; then
  echo "generate-db-schema: pulling $PG_IMAGE (timeout ${PULL_TIMEOUT_SECONDS}s)"
  docker pull "$PG_IMAGE" &
  pull_pid=$!
  waited=0
  while kill -0 "$pull_pid" >/dev/null 2>&1; do
    if ((waited >= PULL_TIMEOUT_SECONDS)); then
      kill "$pull_pid" >/dev/null 2>&1 || true
      wait "$pull_pid" >/dev/null 2>&1 || true
      pull_pid=
      echo "generate-db-schema: image pull exceeded ${PULL_TIMEOUT_SECONDS}s" >&2
      exit 1
    fi
    sleep 1
    ((waited += 1))
  done
  pull_status=0
  wait "$pull_pid" || pull_status=$?
  pull_pid=
  ((pull_status == 0)) || {
    echo "generate-db-schema: failed to pull $PG_IMAGE" >&2
    exit "$pull_status"
  }
fi

docker run -d --name "$CONTAINER" \
  -e POSTGRES_DB="$DB_NAME" \
  -e POSTGRES_USER="$DB_USER" \
  -e POSTGRES_PASSWORD="$DB_PASSWORD" \
  "$PG_IMAGE" >/dev/null

for _ in $(seq 1 60); do
  docker exec "$CONTAINER" pg_isready -U "$DB_USER" -d "$DB_NAME" >/dev/null 2>&1 && break
  sleep 1
done
docker exec "$CONTAINER" pg_isready -U "$DB_USER" -d "$DB_NAME" >/dev/null 2>&1 || {
  echo "generate-db-schema: PostgreSQL did not become ready" >&2
  exit 1
}

# The callback is part of the packaged database contract. Run it before the
# migrations so schema generation also checks the PostgreSQL feature floor.
docker exec -i "$CONTAINER" psql -X -v ON_ERROR_STOP=1 --single-transaction \
  -U "$DB_USER" -d "$DB_NAME" <"$MIGRATION_DIR/beforeMigrate.sql" \
  >/dev/null

shopt -s nullglob
migration_dir=$MIGRATION_DIR
versioned_migrations=("$migration_dir"/V*.sql)
repeatable_migrations=("$migration_dir"/R__*.sql)
[[ ${#versioned_migrations[@]} -gt 0 ]] || {
  echo "generate-db-schema: no versioned migrations found" >&2
  exit 1
}
for migration in "${versioned_migrations[@]}"; do
  file=${migration##*/}
  [[ $file =~ ^V[0-9]+__[A-Za-z0-9_]+\.sql$ ]] || {
    echo "generate-db-schema: invalid versioned migration name: $file" >&2
    exit 1
  }
done
for migration in ${repeatable_migrations[@]+"${repeatable_migrations[@]}"}; do
  file=${migration##*/}
  [[ $file =~ ^R__[A-Za-z0-9_]+\.sql$ ]] || {
    echo "generate-db-schema: invalid repeatable migration name: $file" >&2
    exit 1
  }
done

apply_migration() {
  local migration=$1
  local script_config=${migration}.conf
  local script_settings=
  if [[ -f $script_config ]]; then
    script_settings=$(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$script_config")
    [[ $script_settings == 'executeInTransaction=false' ]] || {
      echo "generate-db-schema: unsupported Flyway script configuration: $script_config" >&2
      exit 1
    }
    docker exec -i "$CONTAINER" psql -X -v ON_ERROR_STOP=1 \
      -U "$DB_USER" -d "$DB_NAME" <"$migration" >/dev/null
    return
  fi
  docker exec -i "$CONTAINER" psql -X -v ON_ERROR_STOP=1 --single-transaction \
    -U "$DB_USER" -d "$DB_NAME" <"$migration" >/dev/null
}

ordered_versioned_migrations() {
  local migration file version
  for migration in "${versioned_migrations[@]}"; do
    file=${migration##*/}
    [[ $file =~ ^V([0-9]+)__ ]]
    version=${BASH_REMATCH[1]}
    printf '%020d\t%s\n' "$((10#$version))" "$migration"
  done | sort -n | cut -f2-
}

while IFS= read -r migration; do
  apply_migration "$migration"
done < <(ordered_versioned_migrations)

for migration in ${repeatable_migrations[@]+"${repeatable_migrations[@]}"}; do
  apply_migration "$migration"
done

{
  printf '%s\n' \
    '-- Generated by bin/generate-db-schema. Do not edit this file.' \
    '-- Flyway migrations are the executable schema authority.' \
    ''
  docker exec "$CONTAINER" pg_dump -U "$DB_USER" -d "$DB_NAME" \
    --schema-only --schema=public --no-owner --no-privileges \
    | sed \
        -e '/^\\restrict /d' \
        -e '/^\\unrestrict /d' \
        -e '/^-- Dumped from database version /d' \
        -e '/^-- Dumped by pg_dump version /d' \
        -e '/^SELECT pg_catalog.set_config/d' \
        -e '/^CREATE SCHEMA public;$/d' \
        -e '/^COMMENT ON SCHEMA public /d' \
    | awk 'BEGIN { preamble = 1 }
        /^-- Name:/ { preamble = 0 }
        preamble && /^SET / { next }
        { print }' \
    | awk 'function occurrences(line, token, count, offset) {
            count = 0
            while ((offset = index(line, token)) != 0) {
                count++
                line = substr(line, offset + length(token))
            }
            return count
        }
        {
            outside_dollar_quote = (dollar_quote == "")
            if (outside_dollar_quote &&
                ($0 == "SET default_tablespace = \047\047;" ||
                 $0 == "SET default_table_access_method = heap;")) {
                next
            }
            if (dollar_quote == "" &&
                match($0, /\$[A-Za-z_][A-Za-z0-9_]*\$|\$\$/)) {
                candidate = substr($0, RSTART, RLENGTH)
                if (occurrences($0, candidate) % 2 == 1) {
                    dollar_quote = candidate
                }
            } else if (dollar_quote != "" &&
                       occurrences($0, dollar_quote) % 2 == 1) {
                dollar_quote = ""
            }
            print
        }' \
    | awk 'BEGIN { RS = ""; ORS = "\n\n" }
        /PostgreSQL database dump/ { next }
        /Name: public; Type: SCHEMA/ { next }
        /Name: SCHEMA public; Type: COMMENT/ { next }
        { print }' \
    | sed '${/^$/d;}'
} >"$generated"

if [[ $mode == check ]]; then
  if ! cmp -s "$generated" "$OUTPUT"; then
    echo "generate-db-schema: $OUTPUT is stale; run ./dev schema" >&2
    diff -u "$OUTPUT" "$generated" || true
    exit 1
  fi
  echo "generated schema matches $OUTPUT"
  exit 0
fi

mv "$generated" "$OUTPUT"
echo "generated $OUTPUT"
