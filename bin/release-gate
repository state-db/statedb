#!/usr/bin/env bash
# Verifies a candidate image by running it.
#
#   bin/release-gate ghcr.io/state-db/statedb:0.1.0
#   bin/release-gate state-db:dev --previous ghcr.io/state-db/statedb:0.0.9
#
set -euo pipefail

cd "$(dirname "$0")/.."
. bin/postgres-images

readonly GATE_ID=$$-$RANDOM
readonly NET=state-db-gate-$GATE_ID
readonly PG=state-db-gate-pg-$GATE_ID
readonly APP=state-db-gate-app-$GATE_ID
readonly FOLLOWER=state-db-gate-app-follower-$GATE_ID
readonly PREVIOUS_TASK=state-db-gate-app-previous-$GATE_ID
readonly CLI=state-db-gate-pulumi-$GATE_ID
readonly IDP=state-db-gate-idp-$GATE_ID
readonly IDP_IMAGE=state-db-gate-idp:$GATE_ID

readonly PG_IMAGE=$STATEDB_POSTGRES_17_IMAGE
readonly CURL_IMAGE=curlimages/curl@sha256:463eaf6072688fe96ac64fa623fe73e1dbe25d8ad6c34404a669ad3ce1f104b6
readonly PULUMI_IMAGE=${PULUMI_IMAGE:-pulumi/pulumi:3.234.0@sha256:5fab0c70cd50a19d0fa7c59cfbc9751d946e27418b2f3e1e4b3735ce1252818b}

readonly DB_ADMIN=gate_admin
readonly DB_USER=gate
readonly DB_PASSWORD=gate
readonly DB_NAME=gate
readonly ORG=gate
readonly STACK=gate
readonly PROJECT_FILE=tools/pulumi/recorder/testproject/Pulumi.yaml
readonly RECORDER_DOCKERFILE=tools/pulumi/recorder/Dockerfile

readonly SESSION_SECRET='release-gate-session-secret-32b!'
readonly RAW_TOKEN=state-db-release-gate-token
readonly ROLLING_TOKEN=state-db-release-gate-rolling-token
readonly VIEWER_TOKEN=state-db-release-gate-viewer-token
readonly CONFIG_PASSPHRASE=release-gate
readonly GLASS_PASSWORD=glass-recovery-pw
readonly GLASS_HASH='$2y$10$lL8GkJSvjMqOCqSTfXX6Xe1vs4EwlJ8UnPk2FNz7/zIGbVTsH.Cea'
image=""
previous=""
expected_commit=""
expected_version=""

while [[ $# -gt 0 ]]; do
  case "$1" in
  --previous)
    previous=${2:?--previous needs an image ref}
    shift 2
    ;;
  --expect-commit)
    expected_commit=${2:?--expect-commit needs a commit}
    shift 2
    ;;
  --expect-version)
    expected_version=${2:?--expect-version needs X.Y.Z}
    shift 2
    ;;
  -*)
    echo "unknown option: $1" >&2
    exit 2
    ;;
  *)
    image=$1
    shift
    ;;
  esac
done

[[ -n $image ]] || {
  echo "usage: release-gate <image> [--previous <image>] [--expect-commit <sha>] [--expect-version <X.Y.Z>]" >&2
  exit 2
}
[[ -n $expected_commit ]] || expected_commit=$(git rev-parse --short=7 HEAD)
if [[ -n $expected_version && ! $expected_version =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo "invalid expected version: $expected_version" >&2
  exit 2
fi

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }
fail() {
  printf '\033[31mgate failed: %s\033[0m\n' "$1" >&2
  exit 1
}

cleanup() {
  docker rm -f "$APP" "$FOLLOWER" "$PREVIOUS_TASK" "$PG" "$CLI" "$IDP" >/dev/null 2>&1 || true
  docker network rm "$NET" >/dev/null 2>&1 || true
  docker image rm -f "$IDP_IMAGE" >/dev/null 2>&1 || true
}
trap 'rc=$?; cleanup; exit "$rc"' EXIT

gate_curl() { docker run --rm --network "$NET" "$CURL_IMAGE" "$@"; }

psql_gate() { docker exec -i "$PG" psql -v ON_ERROR_STOP=1 -U "$DB_USER" -d "$DB_NAME" "$@"; }

expected_schema_history() {
  local migration file version description
  shopt -s nullglob
  {
    for migration in modules/persistence/src/main/resources/db/migration/V*.sql; do
      file=${migration##*/}
      version=${file%%__*}
      version=${version#V}
      [[ $version =~ ^[0-9]+$ ]] || fail "release gate cannot parse migration version from $file"
      description=${file#*__}
      description=${description%.sql}
      description=${description//_/ }
      printf '0|%020d|%s|%s|SQL|true\n' "$((10#$version))" "$version" "$description"
    done
    for migration in modules/persistence/src/main/resources/db/migration/R__*.sql; do
      file=${migration##*/}
      description=${file#R__}
      description=${description%.sql}
      description=${description//_/ }
      printf '1|0|R|%s|SQL|true\n' "$description"
    done
  } | sort -t'|' -k1,1n -k2,2n -k4,4 | cut -d'|' -f3-
}

# macOS has shasum by default; Linux images usually have sha256sum.
sha256_hex() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -d' ' -f1
  else
    shasum -a 256 | cut -d' ' -f1
  fi
}

run_app() {
  local container=$1 ref=$2
  docker rm -f "$container" >/dev/null 2>&1 || true
  docker run -d --name "$container" --network "$NET" --memory=2g --read-only \
    --tmpfs /tmp:rw,noexec,nosuid,size=64m \
    -e STATEDB_JDBC_URL="jdbc:postgresql://$PG:5432/$DB_NAME" \
    -e STATEDB_DB_USER="$DB_USER" \
    -e STATEDB_DB_PASSWORD="$DB_PASSWORD" \
    -e STATEDB_BOOTSTRAP_ORG_NAME="$ORG" \
    -e STATEDB_SESSION_ENCRYPTION_SECRET="$SESSION_SECRET" \
    -e STATEDB_OIDC_BOOTSTRAP_NAME=mock \
    -e STATEDB_OIDC_BOOTSTRAP_ISSUER="http://$IDP:8080/default" \
    -e STATEDB_OIDC_BOOTSTRAP_CLIENT_ID=console \
    -e STATEDB_OIDC_BOOTSTRAP_CLIENT_SECRET=console-secret \
    -e STATEDB_OIDC_DEFAULT_PROVIDER=mock \
    -e STATEDB_ADMIN_SUBJECTS="http://$IDP:8080/default:admin" \
    -e STATEDB_LOCAL_GLASS_PASSWORD_HASH="$GLASS_HASH" \
    -e STATEDB_LOCAL_GLASS_ALLOW_REMOTE=true \
    "$ref" >/dev/null
}

wait_ready() {
  local container=$1 label=$2
  for _ in $(seq 1 90); do
    if readiness=$(gate_curl -sf "http://$container:9000/q/health/ready" 2>/dev/null); then
      readiness_lower=$(printf '%s' "$readiness" | tr '[:upper:]' '[:lower:]')
      [[ $readiness_lower == *cedar* ]] || fail "$label readiness omitted the Cedar self-test"
      echo "$label ready (including Cedar authorization self-test)"
      return 0
    fi
    [[ $(docker inspect -f '{{.State.Status}}' "$container") == running ]] || break
    sleep 2
  done

  docker logs "$container" 2>&1 | tail -100 >&2
  fail "$label did not become ready"
}

start_app() {
  local ref=$1 label=$2
  run_app "$APP" "$ref"
  wait_ready "$APP" "$label"
}

step "Starting Postgres"
docker network create "$NET" >/dev/null
docker run -d --name "$PG" --network "$NET" \
  -e POSTGRES_USER="$DB_ADMIN" -e POSTGRES_PASSWORD="$DB_PASSWORD" -e POSTGRES_DB="$DB_NAME" \
  "$PG_IMAGE" >/dev/null
# Probe over TCP: the image's first-boot setup server answers on the Unix socket only, then stops.
for _ in $(seq 1 60); do
  docker exec "$PG" pg_isready -h 127.0.0.1 -U "$DB_ADMIN" >/dev/null 2>&1 && break
  sleep 1
done
docker exec "$PG" pg_isready -h 127.0.0.1 -U "$DB_ADMIN" >/dev/null 2>&1 || fail "Postgres never became ready"
docker exec -i "$PG" psql -v ON_ERROR_STOP=1 -U "$DB_ADMIN" -d "$DB_NAME" <<SQL >/dev/null
CREATE ROLE $DB_USER LOGIN PASSWORD '$DB_PASSWORD';
GRANT CONNECT ON DATABASE $DB_NAME TO $DB_USER;
GRANT USAGE, CREATE ON SCHEMA public TO $DB_USER;
SQL
database_owner=$(docker exec -i "$PG" psql -tA -U "$DB_ADMIN" -d "$DB_NAME" -c \
  "SELECT pg_get_userbyid(datdba) FROM pg_database WHERE datname = '$DB_NAME'")
[[ $database_owner != "$DB_USER" ]] || fail "release gate app role unexpectedly owns the database"
echo "least-privilege app role can create objects only in schema public"

step "Starting the OIDC provider"
docker build -q -t "$IDP_IMAGE" -f workbench/pulumi/mock-oauth2.Dockerfile . >/dev/null
docker run -d --name "$IDP" --network "$NET" \
  -e 'JSON_CONFIG={"interactiveLogin":true,"httpServer":"NettyWrapper","loginPagePath":"/app/workbench-login.html"}' \
  "$IDP_IMAGE" >/dev/null
for _ in $(seq 1 60); do
  gate_curl -sf "http://$IDP:8080/default/.well-known/openid-configuration" >/dev/null 2>&1 && break
  sleep 1
done
gate_curl -sf "http://$IDP:8080/default/.well-known/openid-configuration" >/dev/null || fail "OIDC provider never became ready"

docker run -d --name "$CLI" --network "$NET" \
  -e PULUMI_CONFIG_PASSPHRASE="$CONFIG_PASSPHRASE" \
  -e PULUMI_SKIP_UPDATE_CHECK=true \
  --entrypoint sh "$PULUMI_IMAGE" -c 'sleep infinity' >/dev/null
docker exec "$CLI" mkdir -p /project
docker cp "$PROJECT_FILE" "$CLI:/project/Pulumi.yaml"
random_version=$(sed -n 's/^ARG RANDOM_PROVIDER_VERSION=//p' "$RECORDER_DOCKERFILE")
[[ -n $random_version ]] || fail "no RANDOM_PROVIDER_VERSION in $RECORDER_DOCKERFILE"
echo "pinning random provider $random_version"
docker exec -w /project "$CLI" pulumi plugin install resource random "$random_version"

step "1/8 Upgrade from the previous release"
if [[ -n $previous ]]; then
  run_app "$PREVIOUS_TASK" "$previous"
  wait_ready "$PREVIOUS_TASK" "previous release ($previous)"
  from_version=$(psql_gate -tA -c 'SELECT max(version) FROM flyway_schema_history')
  echo "previous release left the schema at v${from_version}; keeping it live during candidate migration"
else
  from_version=""
  echo "SKIPPED: no previous release given. Pass --previous once a release exists — an upgrade"
  echo "         that has never been exercised is the failure self-hosters feel first."
fi

step "2/8 Concurrent candidate cold start"
run_app "$APP" "$image"
run_app "$FOLLOWER" "$image"
wait_ready "$APP" "candidate ($image)"
wait_ready "$FOLLOWER" "concurrent candidate follower"
to_version=$(psql_gate -tA -c 'SELECT max(version) FROM flyway_schema_history')
failed=$(psql_gate -tA -c 'SELECT count(*) FROM flyway_schema_history WHERE success = false')
[[ $failed == 0 ]] || fail "$failed migration(s) recorded as failed"
expected_history=$(expected_schema_history)
actual_history=$(psql_gate -tA -c \
  "SELECT coalesce(version, 'R') || '|' || description || '|' || type || '|' || CASE WHEN success THEN 'true' ELSE 'false' END
     FROM (
       SELECT DISTINCT ON (version, description, type)
              version, description, type, success, installed_rank
         FROM flyway_schema_history
        WHERE type = 'SQL'
        ORDER BY version NULLS LAST, description, type, installed_rank DESC
     ) latest
    ORDER BY CASE WHEN version IS NULL THEN 1 ELSE 0 END,
             lpad(coalesce(version, '0'), 20, '0'), description")
[[ $actual_history == "$expected_history" ]] || {
  printf '%s\n' "expected packaged migrations:" "$expected_history" >&2
  printf '%s\n' "actual packaged migrations:" "$actual_history" >&2
  fail "candidate image does not contain the exact migration set"
}
echo "packaged migration set matches the release source"
if [[ -n $from_version ]]; then
  echo "migrations converged: v${from_version} -> v${to_version}"
  wait_ready "$PREVIOUS_TASK" "previous release after candidate migration"
  rolling_hash=$(printf '%s' "$ROLLING_TOKEN" | sha256_hex)
  psql_gate <<SQL >/dev/null
INSERT INTO api_tokens (id, token_hash, description, user_id, org_id, kind, expires_at)
SELECT gen_random_uuid(), '$rolling_hash', 'release-gate-rolling', u.id, o.id, 'service_account', now() + interval '1 day'
FROM organizations o, users u
WHERE o.name = '$ORG' AND u.iss = 'local:bootstrap' AND u.sub = 'admin'
ON CONFLICT (token_hash) DO NOTHING;
SQL
  gate_curl -sf -H "Authorization: token $ROLLING_TOKEN" \
    "http://$PREVIOUS_TASK:8080/pulumi/api/user" >/dev/null ||
    fail "previous release could not serve an authenticated request after candidate migration"
  docker exec -e PULUMI_ACCESS_TOKEN="$ROLLING_TOKEN" -w /project "$CLI" sh -eu -c "
    pulumi login 'http://$PREVIOUS_TASK:8080/pulumi' >/dev/null
    pulumi stack init '$ORG/rolling-upgrade' >/dev/null
    pulumi up --yes --skip-preview >/dev/null
    pulumi destroy --yes --skip-preview >/dev/null
    pulumi stack rm --yes >/dev/null
  " || fail "previous release could not complete a Pulumi write lifecycle after candidate migration"
  echo "previous release completed an authenticated write lifecycle after candidate migration"
else
  echo "schema at v${to_version}"
fi
docker rm -f "$FOLLOWER" >/dev/null

step "3/8 Image contract"
# The containerd image store returns no config for a multi-arch index, so read the running container.
image_user=$(docker inspect "$APP" --format '{{.Config.User}}')
case "$image_user" in
"" | "0" | "root" | "0:0" | "root:root") fail "candidate image runs as root" ;;
*) echo "non-root runtime user: $image_user" ;;
esac

image_license=$(docker inspect "$APP" --format '{{index .Config.Labels "org.opencontainers.image.licenses"}}')
[[ $image_license == AGPL-3.0-only ]] || fail "candidate image license label is '$image_license', expected AGPL-3.0-only"

license_dir=$(mktemp -d)
trap 'rc=$?; rm -rf "$license_dir"; cleanup; exit "$rc"' EXIT
docker cp "$APP:/licenses/." "$license_dir" >/dev/null 2>&1 || fail "candidate does not contain /licenses"
for legal_file in LICENSE NOTICE THIRD-PARTY-NOTICES.txt CEDAR-LICENSE CEDAR-NOTICE CEDAR-THIRD-PARTY-LICENSES.txt; do
  [[ -s "$license_dir/$legal_file" ]] || fail "candidate is missing /licenses/$legal_file"
done
if [[ -s "$license_dir/CEDAR-NATIVE-SHA256" ]]; then
  docker cp "$APP:/work/libcedar_java_ffi.so" "$license_dir/libcedar_java_ffi.so"
  expected_cedar_hash=$(cut -d' ' -f1 "$license_dir/CEDAR-NATIVE-SHA256")
  actual_cedar_hash=$(sha256_hex < "$license_dir/libcedar_java_ffi.so")
  [[ $actual_cedar_hash == "$expected_cedar_hash" ]] || fail "Cedar native library hash does not match its build manifest"
  echo "Cedar native library: $actual_cedar_hash"
fi
rm -rf "$license_dir"
trap 'rc=$?; cleanup; exit "$rc"' EXIT
echo "license label and distribution notices present"

step "4/8 Native authorization contract"
anonymous_status=$(gate_curl -s -o /dev/null -w '%{http_code}' "http://$APP:8080/api/user")
[[ $anonymous_status == 401 ]] || fail "anonymous /api/user returned $anonymous_status, expected 401"

owner_hash=$(printf '%s' "$RAW_TOKEN" | sha256_hex)
viewer_hash=$(printf '%s' "$VIEWER_TOKEN" | sha256_hex)
psql_gate >/dev/null <<SQL
INSERT INTO users (id, iss, sub, email, display_name)
VALUES (gen_random_uuid(), 'local:release-gate', 'viewer', 'viewer@release-gate.invalid', 'Release Gate Viewer')
ON CONFLICT (iss, sub) DO UPDATE SET display_name = EXCLUDED.display_name;

INSERT INTO org_members (org_id, user_id, role)
SELECT o.id, u.id, 'viewer'
FROM organizations o, users u
WHERE o.name = '$ORG' AND u.iss = 'local:release-gate' AND u.sub = 'viewer'
ON CONFLICT (org_id, user_id) DO UPDATE SET role = EXCLUDED.role;

INSERT INTO api_tokens (id, token_hash, description, user_id, org_id, kind, expires_at)
SELECT gen_random_uuid(), '$viewer_hash', 'release-gate-viewer', u.id, o.id, 'service_account', now() + interval '1 day'
FROM organizations o, users u
WHERE o.name = '$ORG' AND u.iss = 'local:release-gate' AND u.sub = 'viewer'
ON CONFLICT (token_hash) DO NOTHING;

INSERT INTO api_tokens (id, token_hash, description, user_id, org_id, kind, expires_at)
SELECT gen_random_uuid(), '$owner_hash', 'release-gate-owner', u.id, o.id, 'service_account', now() + interval '1 day'
FROM organizations o, users u
WHERE o.name = '$ORG' AND u.iss = 'local:bootstrap' AND u.sub = 'admin'
ON CONFLICT (token_hash) DO NOTHING;
SQL

viewer_status=$(gate_curl -s -o /dev/null -w '%{http_code}' \
  -H "Authorization: token $VIEWER_TOKEN" \
  -H 'Content-Type: application/json' \
  -d '{"stackName":"native-authz-check","tags":{"pulumi:project":"native-gate"}}' \
  "http://$APP:8080/pulumi/api/stacks/$ORG/native-gate")
[[ $viewer_status == 403 ]] || fail "viewer stack creation returned $viewer_status, expected Cedar deny (403)"

owner_status=$(gate_curl -s -o /dev/null -w '%{http_code}' \
  -H "Authorization: token $RAW_TOKEN" \
  -H 'Content-Type: application/json' \
  -d '{"stackName":"native-authz-check","tags":{"pulumi:project":"native-gate"}}' \
  "http://$APP:8080/pulumi/api/stacks/$ORG/native-gate")
[[ $owner_status == 200 ]] || fail "owner stack creation returned $owner_status, expected Cedar allow (200)"
echo "anonymous rejected; Cedar viewer deny and owner allow passed"

step "5/8 OIDC, authenticated console, projections, SPA, compaction, and break-glass"
console_results=$(
  docker run --rm -i --network "$NET" -e GATE_APP="$APP" -e GATE_ORG="$ORG" "$CURL_IMAGE" sh -eu -s <<'EOF'
  echo 'OIDC: starting authorization flow' >&2
  login_url=$(curl -sfS -c /tmp/j -b /tmp/j -L -o /tmp/login -w '%{url_effective}' \
    "http://$GATE_APP:8080/api/auth/login/mock?returnTo=/")
  echo "OIDC: posting login to $login_url" >&2
  curl -sfS -c /tmp/j -b /tmp/j -L -o /dev/null "$login_url" \
    --data-urlencode username=admin \
    --data-urlencode 'claims={"email":"admin@release-gate.invalid","name":"Release Gate Admin"}'
  echo 'OIDC: reading authenticated APIs' >&2
  curl -sfS -b /tmp/j "http://$GATE_APP:8080/api/version"
  printf '\n'
  curl -sfS -b /tmp/j "http://$GATE_APP:8080/api/user" >/dev/null
  curl -sfS -b /tmp/j "http://$GATE_APP:8080/api/workspaces" >/dev/null
  curl -sfS -b /tmp/j "http://$GATE_APP:8080/api/admin/compaction-jobs" >/dev/null
  curl -sfS "http://$GATE_APP:8080/" | grep -qi '<!doctype html>'
  echo 'OIDC: forcing compaction' >&2
  curl -sfS -b /tmp/j -X POST \
    "http://$GATE_APP:8080/api/admin/stacks/$GATE_ORG/native-gate/native-authz-check/compact" >/dev/null
EOF
) || {
  docker logs "$APP" 2>&1 | tail -150 >&2
  fail "native OIDC login, authenticated projections, or SPA delivery failed"
}
compaction_status=
for _ in $(seq 1 30); do
  compaction_status=$(psql_gate -tA -c 'SELECT status FROM compaction_jobs ORDER BY created_at DESC LIMIT 1')
  [[ $compaction_status == completed ]] && break
  [[ $compaction_status != failed ]] || break
  sleep 1
done
[[ $compaction_status == completed ]] || fail "forced compaction ended with status ${compaction_status:-missing}"

version_json=$(printf '%s\n' "$console_results" | head -n 1)
echo "$version_json"
case "$version_json" in
*"\"commit\":\"$expected_commit\""*) echo "commit matches $expected_commit" ;;
*) fail "image reports a different commit than $expected_commit" ;;
esac
if [[ -n $expected_version ]]; then
  case "$version_json" in
  *"\"build\":\"$expected_version\""*) echo "build version matches $expected_version" ;;
  *) fail "image reports a different build version than $expected_version" ;;
  esac
fi

psql_gate -c "UPDATE oidc_providers SET enabled = false" >/dev/null
docker run --rm --network "$NET" "$CURL_IMAGE" sh -eu -c "
  curl -sfS -c /tmp/glass -b /tmp/glass \
    -H 'Content-Type: application/x-www-form-urlencoded' \
    --data-urlencode username=admin --data-urlencode password='$GLASS_PASSWORD' \
    http://$APP:8080/api/auth/local >/dev/null
  curl -sfS -b /tmp/glass http://$APP:8080/api/user >/dev/null
" || fail "native break-glass login or authenticated read failed"
echo "break-glass bcrypt login and encrypted session passed"

step "6/8 Pulumi up / refresh / destroy against the running image"
docker exec -e PULUMI_ACCESS_TOKEN="$RAW_TOKEN" -w /project "$CLI" sh -eu -c "
  pulumi login 'http://$APP:8080/pulumi' >/dev/null
  pulumi stack init '$ORG/$STACK' >/dev/null
  pulumi up --yes --skip-preview
  pulumi refresh --yes --skip-preview
  pulumi stack export >/tmp/export.json
  pulumi destroy --yes --skip-preview
  pulumi stack rm --yes
" || fail "the Pulumi CLI could not complete a lifecycle against this image"

step "7/8 Database outage and readiness recovery"
docker stop "$PG" >/dev/null
outage_status=$(gate_curl --max-time 10 -s -o /dev/null -w '%{http_code}' \
  "http://$APP:9000/q/health/ready" || true)
[[ $(docker inspect -f '{{.State.Status}}' "$APP") == running ]] || fail "candidate died during the database outage"
[[ $outage_status == 503 ]] || fail "readiness returned $outage_status during the database outage, expected 503"
docker start "$PG" >/dev/null
for _ in $(seq 1 60); do
  docker exec "$PG" pg_isready -U "$DB_USER" >/dev/null 2>&1 && break
  sleep 1
done
for _ in $(seq 1 60); do
  gate_curl -sf "http://$APP:9000/q/health/ready" >/dev/null 2>&1 && break
  sleep 1
done
gate_curl -sf "http://$APP:9000/q/health/ready" >/dev/null || fail "readiness did not recover after Postgres restarted"
echo "readiness went down with Postgres and recovered without restarting the app"

step "8/8 Graceful shutdown"
docker stop --time 10 "$APP" >/dev/null
app_exit=$(docker inspect -f '{{.State.ExitCode}}' "$APP")
case "$app_exit" in
0 | 143) echo "SIGTERM completed within the 10-second grace period (exit $app_exit)" ;;
*) fail "candidate exited with status $app_exit after SIGTERM" ;;
esac

printf '\n\033[32mgate passed: %s is releasable\033[0m\n' "$image"
