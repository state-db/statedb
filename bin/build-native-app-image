#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

image=state-db:native-dev
requested_version=

if [[ $# -gt 0 && $1 != --* ]]; then
  image=$1
  shift
fi
while [[ $# -gt 0 ]]; do
  case "$1" in
  --version)
    requested_version=${2:?--version needs X.Y.Z}
    shift 2
    ;;
  *)
    echo "usage: build-native-app-image [image] [--version X.Y.Z]" >&2
    exit 2
    ;;
  esac
done

if [[ -n $requested_version && ! $requested_version =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo "error: build version '$requested_version' is not X.Y.Z" >&2
  exit 2
fi

docker buildx version >/dev/null 2>&1 || {
  echo "error: Docker Buildx is required for native image builds" >&2
  exit 1
}

{
  IFS= read -r BUILD_VERSION
  IFS= read -r BUILD_COMMIT
  IFS= read -r SOURCE_DATE_EPOCH
} < <(./bin/build-version --values)
[[ -z $requested_version ]] || BUILD_VERSION=$requested_version
readonly BUILD_VERSION BUILD_COMMIT SOURCE_DATE_EPOCH

docker buildx build --load \
  -f modules/app/src/main/docker/Dockerfile.native \
  --build-arg BUILD_VERSION="$BUILD_VERSION" \
  --build-arg BUILD_COMMIT="$BUILD_COMMIT" \
  --build-arg SOURCE_DATE_EPOCH="$SOURCE_DATE_EPOCH" \
  --build-arg NATIVE_IMAGE_XMX="${NATIVE_IMAGE_XMX:-6g}" \
  --build-arg NATIVE_IMAGE_PARALLELISM="${NATIVE_IMAGE_PARALLELISM:-2}" \
  --build-arg NATIVE_IMAGE_OPTIMIZATION="${NATIVE_IMAGE_OPTIMIZATION:-2}" \
  --build-arg NATIVE_NEGATIVE_METADATA_TEST="${NATIVE_NEGATIVE_METADATA_TEST:-false}" \
  -t "$image" .

echo "Built $image"
