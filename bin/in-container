#!/usr/bin/env bash
# Single gateway for project commands. All build/test/lint/run/migrate work —
# whether driven by humans, Make, or coding agents — MUST go through this
# wrapper. Host execution of project commands is unsupported; the host
# environment is assumed incomplete (wrong JDK, no Maven, etc.).
#
# Behavior:
#   - Already inside the dev container → exec directly.
#   - On host → prefer `devcontainer exec`; fall back to `docker exec` against
#     the container labeled with this workspace folder.
#   - No container running → fail with a remediation message. We do NOT
#     auto-start: bringing a devcontainer up is a coarse, editor-driven step.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [[ $# -eq 0 ]]; then
  cat >&2 <<'USAGE'
usage: bin/in-container <command> [args...]

Runs <command> inside the project dev container. Examples:
  bin/in-container mvn -f modules/pom.xml test
  bin/in-container bash -lc 'mvn -v && java -version'
USAGE
  exit 64
fi

if [[ -f /.dockerenv ]]; then
  exec "$@"
fi

cd "$REPO_ROOT"

# Prefer the official CLI: it picks the right user/workdir/env the same way
# the editor integrations do. If the container is down it produces its own
# error — the user fixes that by opening the folder in their editor or
# running `devcontainer up`.
#
# Exception: when invoked from a Make recipe, this devcontainer CLI build exits
# before running the requested command. Fall through to the docker-exec path
# below; it uses the same devcontainer label and remote user.
if [[ -z "${MAKELEVEL:-}" ]] && command -v devcontainer >/dev/null 2>&1; then
  exec devcontainer exec --workspace-folder "$REPO_ROOT" "$@"
fi

# Fallback: locate the container by the standard devcontainer label.
CID="$(docker ps \
  --filter "label=devcontainer.local_folder=$REPO_ROOT" \
  --format '{{.ID}}')"

if [[ -z "$CID" ]]; then
  cat >&2 <<EOF
error: no running dev container for $REPO_ROOT, and the 'devcontainer' CLI
is not on PATH.

Start the container, then retry:
  devcontainer up --workspace-folder "$REPO_ROOT"

Or open the folder in your editor (Zed: "Rebuild Container";
VS Code: "Reopen in Container") and wait for it to come up.
EOF
  exit 69
fi

# Run as the devcontainer remoteUser (vscode for the java image). Running as
# root would create files the host user can't edit cleanly.
DOCKER_FLAGS=(-i)
if [[ -t 0 && -t 1 ]]; then
  DOCKER_FLAGS+=(-t)
fi

exec docker exec "${DOCKER_FLAGS[@]}" \
  -u vscode \
  -w "/workspaces/$(basename "$REPO_ROOT")" \
  "$CID" \
  "$@"
