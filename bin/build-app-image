#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

image=${1:-state-db:dev}
docker_cfg=${DOCKER_CFG:-/tmp/state-db-dockercfg}

mkdir -p "$docker_cfg"
export DOCKER_CONFIG="$docker_cfg"

eval "$(./bin/build-version --env)"

docker build \
  -f modules/app/src/main/docker/Dockerfile.jvm \
  --build-arg BUILD_VERSION="$BUILD_VERSION" \
  --build-arg BUILD_COMMIT="$BUILD_COMMIT" \
  --build-arg SOURCE_DATE_EPOCH="$SOURCE_DATE_EPOCH" \
  -t "$image" .

echo "Built $image"
