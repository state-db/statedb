#!/usr/bin/env bash
# Regenerates THIRD-PARTY-NOTICES.txt, the attribution file for the open-source
# components distributed with the state-db server and web console. The file is
# checked in, bundled into the app jar (served at /THIRD-PARTY-NOTICES.txt),
# and kept fresh by CI via --check.
#
#   ./dev notices                             # rewrite THIRD-PARTY-NOTICES.txt
#   ./dev check                               # fail if the committed file is stale
#
# Sources:
#   - Server: license-maven-plugin add-third-party on modules/app (runtime deps).
#   - Console: modules/web/scripts/collect-licenses.ts (deps + license texts).
#   - Pulumi: third_party/pulumi/LICENSE appended as the Apache-2.0 text.
#   - Cedar: native-library notices vendored at the Maven dependency version.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

[[ ${STATEDB_ISOLATED:-} == 1 ]] || {
  echo "error: dependency notices must be generated through ./dev notices" >&2
  exit 1
}

case $#:${1:-} in
0:) CHECK=0 ;;
1:--check) CHECK=1 ;;
*)
  echo "usage: generate-third-party-notices [--check]" >&2
  exit 2
  ;;
esac

CEDAR_VERSION=$(sed -n 's:.*<cedar-java.version>\([^<]*\)</cedar-java.version>.*:\1:p' modules/pom.xml)
grep -q "\`v${CEDAR_VERSION}\` tag" third_party/cedar-java/README.md || {
  echo "error: third_party/cedar-java is not documented as Cedar v${CEDAR_VERSION}" >&2
  exit 1
}
for file in LICENSE NOTICE THIRD_PARTY_LICENSES.txt SHA256SUMS; do
  [[ -s "third_party/cedar-java/$file" ]] || {
    echo "error: missing third_party/cedar-java/$file" >&2
    exit 1
  }
done
for file in LICENSE NOTICE THIRD_PARTY_LICENSES.txt; do
  expected=$(awk -v path="$file" '$2 == path { print $1 }' third_party/cedar-java/SHA256SUMS)
  if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "third_party/cedar-java/$file" | cut -d' ' -f1)
  else
    actual=$(shasum -a 256 "third_party/cedar-java/$file" | cut -d' ' -f1)
  fi
  [[ -n "$expected" && "$actual" == "$expected" ]] || {
    echo "error: third_party/cedar-java/$file does not match SHA256SUMS" >&2
    exit 1
  }
done

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT

echo "Collecting server (Maven) dependency licenses..." >&2
MAVEN_LIST="modules/app/target/generated-sources/license/THIRD-PARTY.txt"
# The mojo's up-to-date check only watches the module's own pom, so config
# changes in the parent would silently reuse a stale file. Force regeneration.
rm -f "$MAVEN_LIST"
modules/mvnw -f modules/pom.xml -pl app -am -q -DskipTests \
  compile license:add-third-party
if [[ ! -s "$MAVEN_LIST" ]]; then
  echo "error: $MAVEN_LIST was not generated" >&2
  exit 1
fi

# Brotli4j selects one native artifact from the build machine's architecture. Replace every
# resolved native row with the two shipped architectures, including their correct project URLs.
native_line=$(grep -m1 -E 'com\.aayushatharva\.brotli4j:native-linux-(aarch64|x86_64):' "$MAVEN_LIST")
native_count=$(grep -Ec 'com\.aayushatharva\.brotli4j:native-linux-(aarch64|x86_64):' "$MAVEN_LIST")
aarch64_line=$(sed -E 's/native-linux-(aarch64|x86_64)/native-linux-aarch64/g' <<<"$native_line")
x86_64_line=$(sed -E 's/native-linux-(aarch64|x86_64)/native-linux-x86_64/g' <<<"$native_line")
declared_count=$(sed -nE 's/.*Lists of ([0-9]+) third-party dependencies.*/\1/p' "$MAVEN_LIST")
normalized_count=$((declared_count + 2 - native_count))
awk -v aarch64="$aarch64_line" -v x86_64="$x86_64_line" \
    -v old_count="$declared_count" -v new_count="$normalized_count" '
  /Lists of [0-9]+ third-party dependencies/ {
    sub("Lists of " old_count, "Lists of " new_count)
  }
  /com\.aayushatharva\.brotli4j:brotli4j:/ {
    print
    print aarch64
    print x86_64
    next
  }
  /com\.aayushatharva\.brotli4j:native-linux-(aarch64|x86_64):/ { next }
  { print }
' "$MAVEN_LIST" > "$MAVEN_LIST.normalized"
mv "$MAVEN_LIST.normalized" "$MAVEN_LIST"

# Non-Apache components must have their license text vendored in
# third_party/java-licenses/<groupId>.txt (extracted from the jar's embedded
# META-INF license files, or from the upstream repo at the shipped version).
# Fail in both drift directions so the vendored set tracks the dependency set.
JAVA_LICENSES_DIR="third_party/java-licenses"
NON_APACHE_LINES="$WORK_DIR/non-apache-lines.txt"
grep -E '^ +\(' "$MAVEN_LIST" | grep -vF '(Apache License 2.0)' | sed 's/^ *//' \
  > "$NON_APACHE_LINES" || true
NON_APACHE_GROUPS=$(sed -E 's/.*\(([A-Za-z0-9_.-]+):[A-Za-z0-9_.-]+:[^ )]* - [^)]*\)$/\1/' \
  "$NON_APACHE_LINES" | sort -u)

MISSING=""
for group in $NON_APACHE_GROUPS; do
  [[ -f "$JAVA_LICENSES_DIR/$group.txt" ]] || MISSING="$MISSING $group"
done
if [[ -n "$MISSING" ]]; then
  echo "error: non-Apache dependencies without a vendored license text:$MISSING" >&2
  echo "Add $JAVA_LICENSES_DIR/<groupId>.txt with the component's license" >&2
  echo "text (prefer the jar's embedded META-INF/LICENSE*/NOTICE* files)." >&2
  exit 1
fi
for file in "$JAVA_LICENSES_DIR"/*.txt; do
  group="$(basename "$file" .txt)"
  if ! grep -qx "$group" <<< "$NON_APACHE_GROUPS"; then
    echo "error: $file does not match any non-Apache dependency; remove it" >&2
    echo "(or the dependency's license metadata changed — see $MAVEN_LIST)." >&2
    exit 1
  fi
done

JAVA_TEXTS="$WORK_DIR/java-license-texts.txt"
{
  first=1
  for group in $NON_APACHE_GROUPS; do
    if [[ $first -eq 0 ]]; then printf '\n\n'; fi
    first=0
    printf '%s\n' "$(printf -- '-%.0s' {1..72})"
    grep -F "($group:" "$NON_APACHE_LINES"
    printf '\n'
    cat "$JAVA_LICENSES_DIR/$group.txt"
  done
} > "$JAVA_TEXTS"

echo "Collecting web console (bun) dependency licenses..." >&2
(
  cd modules/web
  bun install --frozen-lockfile >/dev/null
  bun scripts/collect-licenses.ts
) > "$WORK_DIR/web-licenses.txt"

OUT="$WORK_DIR/THIRD-PARTY-NOTICES.txt"
{
  cat <<'HEADER'
state-db third-party notices
============================

This file lists the open-source components distributed with the state-db
server and web console, together with their licenses. It is generated by
`./dev notices`; do not edit by hand.

state-db itself is licensed under the Elastic License 2.0 with Additional
Limitations (see LICENSE). Trademark notices and the Pulumi derivation
notice are in NOTICE.

state-db includes compatibility tooling, recorded protocol fixtures, and API
snapshots derived from public Pulumi source code and API descriptions. Pulumi
is Copyright Pulumi Corporation and contributors, licensed under the Apache
License 2.0. The full text of that license appears in the appendix at the end
of this file and in third_party/pulumi/LICENSE.


Server (Java) components
========================

The following components are bundled in the state-db server. Each line names
the license, the component, its Maven coordinates, and its project page. The
Apache License 2.0, which covers most of these components, is reproduced in
the appendix; the license texts of all non-Apache components are reproduced
in the next section.

HEADER
  cat "$MAVEN_LIST"
  cat <<'JAVATEXTS'


Non-Apache server component license texts
=========================================

License texts (and notices, where the project ships them) for the server
components above that are not Apache-2.0 licensed, grouped by Maven group
id. Texts are taken from the license files embedded in the shipped jars
where present, otherwise from the component's upstream repository at the
shipped version. They are maintained in third_party/java-licenses/ and
checked against the dependency list by the generator.

JAVATEXTS
  cat "$JAVA_TEXTS"
  cat <<'CEDARHEADER'


Cedar native library notices
============================

The cedar-java uber JAR includes Cedar and JNE native libraries. Their upstream
distribution notices follow and are also shipped as separate files in the image.

CEDARHEADER
  cat third_party/cedar-java/NOTICE
  printf '\n\n'
  cat third_party/cedar-java/THIRD_PARTY_LICENSES.txt
  cat <<'WEBHEADER'


Web console (JavaScript) components
===================================

The following packages are bundled in the state-db web console, listed with
their declared license and the verbatim license/notice files each package
ships.

WEBHEADER
  cat "$WORK_DIR/web-licenses.txt"
  cat <<'APPENDIX'


Appendix: Apache License 2.0
============================

APPENDIX
  cat third_party/pulumi/LICENSE
} > "$OUT"

if [[ "$CHECK" -eq 1 ]]; then
  if ! diff -u THIRD-PARTY-NOTICES.txt "$OUT" > "$WORK_DIR/notices.diff" 2>&1; then
    echo "error: THIRD-PARTY-NOTICES.txt is stale. Run './dev notices' and commit the result." >&2
    head -40 "$WORK_DIR/notices.diff" >&2
    exit 1
  fi
  echo "THIRD-PARTY-NOTICES.txt is up to date." >&2
else
  mv "$OUT" THIRD-PARTY-NOTICES.txt
  echo "Wrote THIRD-PARTY-NOTICES.txt" >&2
fi
