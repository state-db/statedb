#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

image=${1:?usage: verify-native-metadata-negative <image>}
suffix=$$
network="state-db-native-negative-$suffix"
postgres="state-db-native-negative-pg-$suffix"
application="state-db-native-negative-app-$suffix"
curl_image='curlimages/curl@sha256:463eaf6072688fe96ac64fa623fe73e1dbe25d8ad6c34404a669ad3ce1f104b6'

cleanup() {
  docker rm -f "$application" "$postgres" >/dev/null 2>&1 || true
  docker network rm "$network" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker network create "$network" >/dev/null
docker run -d --name "$postgres" --network "$network" \
  -e POSTGRES_USER=negative -e POSTGRES_PASSWORD=negative -e POSTGRES_DB=negative \
  postgres:17-alpine >/dev/null
# Probe over TCP: the image's first-boot setup server answers on the Unix socket only, then stops.
for _ in $(seq 1 60); do
  docker exec "$postgres" pg_isready -h 127.0.0.1 -U negative >/dev/null 2>&1 && break
  sleep 1
done
docker exec "$postgres" pg_isready -h 127.0.0.1 -U negative >/dev/null 2>&1 || {
  echo 'error: negative-test Postgres did not become ready' >&2
  exit 1
}

docker run -d --name "$application" --network "$network" \
  -e STATEDB_JDBC_URL="jdbc:postgresql://$postgres:5432/negative" \
  -e STATEDB_DB_USER=negative -e STATEDB_DB_PASSWORD=negative \
  "$image" >/dev/null

for _ in $(seq 1 30); do
  body=$(docker run --rm --network "$network" "$curl_image" \
    -s "http://$application:9000/q/health/ready" 2>/dev/null || true)
  if jq -e \
    '.status == "DOWN" and any(.checks[]; .name == "Cedar authorization self-test" and .status == "DOWN")' \
    >/dev/null 2>&1 <<<"$body"; then
    logs=$(docker logs "$application" 2>&1)
    if [[ $logs == *'No serializer found for class com.cedarpolicy.serializer.JsonEUID'* ]]; then
      echo 'negative metadata artifact was rejected by the Cedar native readiness contract'
      return_status=0
      break
    fi
  fi
  sleep 1
done

if [[ ${return_status:-1} -ne 0 ]]; then
  docker logs "$application" >&2
  echo 'error: missing JsonEUID metadata did not produce the expected native failure' >&2
  exit 1
fi
