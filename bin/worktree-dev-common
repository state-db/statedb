#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -d "$REPO_ROOT/.git" ]]; then
  echo "error: worktree-dev scripts are for linked worktrees, not the main checkout" >&2
  exit 64
fi

WORKTREE_PARENT="$(dirname "$REPO_ROOT")"
RAW_WORKTREE_KEY=${STATEDB_WORKTREE_KEY:-$(basename "$WORKTREE_PARENT")}
WORKTREE_KEY="$(printf '%s' "$RAW_WORKTREE_KEY" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')"
if [[ -z "$WORKTREE_KEY" || ! "$WORKTREE_KEY" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]]; then
  echo "error: invalid worktree key: $RAW_WORKTREE_KEY" >&2
  exit 64
fi

WORKTREE_DB="statedb_${WORKTREE_KEY//-/_}"
WORKTREE_PROVIDER="mock-$WORKTREE_KEY"
WORKTREE_APP_PORT="${STATEDB_WORKTREE_APP_PORT:-18080}"
WORKTREE_CONSOLE_PORT="${STATEDB_WORKTREE_CONSOLE_PORT:-15173}"
WORKTREE_DB_PORT="${STATEDB_WORKTREE_DB_PORT:-55432}"
WORKTREE_IDP_PORT="${STATEDB_WORKTREE_IDP_PORT:-58081}"
WORKTREE_CONSOLE_HOST="127.0.0.1"
WORKTREE_ISSUER="http://$WORKTREE_CONSOLE_HOST:$WORKTREE_CONSOLE_PORT/default"

if (( WORKTREE_APP_PORT < 1024 || WORKTREE_APP_PORT > 65535 \
      || WORKTREE_CONSOLE_PORT < 1024 || WORKTREE_CONSOLE_PORT > 65535 \
      || WORKTREE_DB_PORT < 1024 || WORKTREE_DB_PORT > 65535 \
      || WORKTREE_IDP_PORT < 1024 || WORKTREE_IDP_PORT > 65535 )); then
  echo "error: worktree ports must be between 1024 and 65535" >&2
  exit 64
fi

export REPO_ROOT WORKTREE_KEY WORKTREE_DB WORKTREE_PROVIDER
export WORKTREE_APP_PORT WORKTREE_CONSOLE_HOST WORKTREE_CONSOLE_PORT WORKTREE_DB_PORT
export WORKTREE_IDP_PORT WORKTREE_ISSUER
