#!/usr/bin/env bash
# Internal service supervisor. Invoke through worktree-dev-up/down, not directly.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
: "${WORKTREE_KEY:?}" "${WORKTREE_DB:?}" "${WORKTREE_PROVIDER:?}"
: "${WORKTREE_CONSOLE_PORT:?}" "${WORKTREE_DB_PORT:?}" "${WORKTREE_IDP_PORT:?}" "${WORKTREE_ISSUER:?}"

RUN_DIR="/tmp/state-db-worktree-$WORKTREE_KEY"

stop_services() {
  [[ -d "$RUN_DIR" ]] || return 0
  for pid_file in "$RUN_DIR"/*.pid; do
    [[ -f "$pid_file" ]] || continue
    pid="$(cat "$pid_file")"
    kill -TERM "$pid" 2>/dev/null || true
  done
  sleep 1
  for pid_file in "$RUN_DIR"/*.pid; do
    [[ -f "$pid_file" ]] || continue
    pid="$(cat "$pid_file")"
    kill -KILL "$pid" 2>/dev/null || true
  done
  rm -rf "$RUN_DIR"
}

case "${1:-}" in
  start)
    stop_services
    mkdir -p "$RUN_DIR"

    nohup socat \
      "TCP-LISTEN:$WORKTREE_CONSOLE_PORT,bind=127.0.0.1,reuseaddr,fork" \
      TCP:127.0.0.1:5173 >"$RUN_DIR/oidc-forward.log" 2>&1 &
    echo $! >"$RUN_DIR/oidc-forward.pid"

    (
      cd "$REPO_ROOT/modules/web"
      # A linked worktree is a fresh working tree with no node_modules (gitignored),
      # so install before starting the dev server. exec keeps the PID stable for the pid file.
      bun install >"$RUN_DIR/web.log" 2>&1
      exec nohup env PORT=5173 \
        OIDC_PROXY_TARGET="http://host.docker.internal:$WORKTREE_IDP_PORT" \
        bun dev.ts >>"$RUN_DIR/web.log" 2>&1
    ) &
    echo $! >"$RUN_DIR/web.pid"

    (
      cd "$REPO_ROOT"
      exec nohup env \
        QUARKUS_DATASOURCE_DEVSERVICES_ENABLED=false \
        QUARKUS_DATASOURCE_JDBC_URL="jdbc:postgresql://host.docker.internal:$WORKTREE_DB_PORT/$WORKTREE_DB" \
        QUARKUS_DATASOURCE_USERNAME=statedb \
        QUARKUS_DATASOURCE_PASSWORD=statedb \
        QUARKUS_HTTP_HOST=0.0.0.0 \
        QUARKUS_HTTP_PROXY_PROXY_ADDRESS_FORWARDING=true \
        QUARKUS_HTTP_PROXY_ENABLE_FORWARDED_HOST=true \
        QUARKUS_HTTP_PROXY_ENABLE_FORWARDED_PREFIX=true \
        STATEDB_BOOTSTRAP_ORG_NAME=acme \
        STATEDB_BOOTSTRAP_ORG_DISPLAY_NAME="Acme Workbench $WORKTREE_KEY" \
        STATEDB_OIDC_BOOTSTRAP_NAME="$WORKTREE_PROVIDER" \
        STATEDB_OIDC_BOOTSTRAP_ISSUER="$WORKTREE_ISSUER" \
        STATEDB_OIDC_BOOTSTRAP_CLIENT_ID=console \
        STATEDB_OIDC_BOOTSTRAP_CLIENT_SECRET=console-secret \
        STATEDB_OIDC_DEFAULT_PROVIDER="$WORKTREE_PROVIDER" \
        STATEDB_SESSION_ENCRYPTION_SECRET=state-db-workbench-session-secret-32-bytes \
        STATEDB_ADMIN_SUBJECTS="$WORKTREE_ISSUER:admin" \
        mvn -f modules/pom.xml -pl app -am \
          -Dquarkus.test.continuous-testing=disabled quarkus:dev \
          >"$RUN_DIR/app.log" 2>&1
    ) &
    echo $! >"$RUN_DIR/app.pid"

    nohup env \
      DB_CONTAINER=state-db-workbench-postgres \
      DB_USER=statedb \
      DB_NAME="$WORKTREE_DB" \
      ORG=acme \
      OIDC_ISSUER="$WORKTREE_ISSUER" \
      ADMIN_SUB=admin \
      TOKEN_HASH=5ffbb9af69ff36cfa7e28cea7b3da597ed0d0489113674b3eb3a6c2b7e386ef5 \
      sh "$REPO_ROOT/workbench/pulumi/seed-console.sh" \
      >"$RUN_DIR/seed.log" 2>&1 &
    echo $! >"$RUN_DIR/seed.pid"

    echo "logs: $RUN_DIR"
    ;;
  stop)
    stop_services
    ;;
  *)
    echo "usage: $0 start|stop" >&2
    exit 64
    ;;
esac
