#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

registry=signatures/v1/cla.json
base=${1:?usage: check-cla-acceptance <base-sha> <head-sha> <github-login>}
head=${2:?usage: check-cla-acceptance <base-sha> <head-sha> <github-login>}
github_login=${3:?usage: check-cla-acceptance <base-sha> <head-sha> <github-login>}

fail() {
  echo "CLA check failed: $*" >&2
  exit 1
}

command -v jq >/dev/null || fail "jq is required"
jq -e '
  .schemaVersion == 1
  and (.agreements | type == "object")
  and (.steward.githubLogins | type == "array")
  and (.steward.gitIdentities | type == "array")
  and (.automation.githubLogins | type == "array")
  and (.automation.gitIdentities | type == "array")
  and (.acceptances | type == "array")
' "$registry" >/dev/null ||
  fail "$registry has an invalid schema"

if ! jq -e '
  . as $registry
  | all($registry.acceptances[];
    (.agreement | type == "string")
    and (.agreementSha256 | type == "string")
    and (.agreement as $version
      | .agreementSha256 == $registry.agreements[$version].sha256)
    and (.githubLogin | type == "string" and length > 0)
    and (.legalName | type == "string" and length > 0)
    and (.contactEmail | type == "string" and length > 0)
    and (.acceptedAt | type == "string"
      and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"))
    and (.evidenceUrl | type == "string" and startswith("https://"))
    and (.gitIdentities | type == "array" and length > 0)
    and all(.gitIdentities[]; (.name | type == "string" and length > 0)
      and (.email | type == "string" and length > 0))
    and (if .agreement == "CCLA-1.0" then
      (.legalEntity | type == "string" and length > 0)
      and (.authorizedRepresentative | type == "string" and length > 0)
      and (.coveredContributors | type == "array" and length > 0)
      and all(.coveredContributors[];
        (.legalName | type == "string" and length > 0)
        and (.gitIdentities | type == "array" and length > 0)
        and all(.gitIdentities[]; (.name | type == "string" and length > 0)
          and (.email | type == "string" and length > 0)))
    else .agreement == "ICLA-1.0" end))
' "$registry" >/dev/null; then
  fail "$registry contains an incomplete acceptance or an agreement hash mismatch"
fi

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

while IFS=$'\t' read -r version path expected; do
  [[ -f $path ]] || fail "$version refers to missing agreement $path"
  actual=$(sha256_file "$path")
  [[ $actual == "$expected" ]] ||
    fail "$version hash is $actual; update the agreement version before collecting acceptances"
done < <(jq -r '.agreements | to_entries[] | [.key, .value.path, .value.sha256] | @tsv' "$registry")

if ! jq -e --arg login "$github_login" '
  (.steward.githubLogins + .automation.githubLogins + [.acceptances[].githubLogin])
  | index($login) != null
' "$registry" >/dev/null; then
  fail "GitHub user $github_login has no recorded contributor agreement"
fi

while IFS=$'\t' read -r name email; do
  if ! jq -e --arg name "$name" --arg email "$email" '
    (.steward.gitIdentities + .automation.gitIdentities
      + [.acceptances[].gitIdentities[]]
      + [.acceptances[].coveredContributors[]?.gitIdentities[]?])
    | any(.name == $name and .email == $email)
  ' "$registry" >/dev/null; then
    fail "Git author $name <$email> is not covered by a recorded contributor agreement"
  fi
done < <(git log --format='%an%x09%ae' "$base..$head" | sort -u)

echo "CLA records cover $github_login and all Git authors in $base..$head"
