#!/usr/bin/env bash
# Stable workspace interface. Toolchain and isolation mechanics stay behind this seam.
set -euo pipefail

cd "$(dirname "$0")"

readonly VERIFY_VM=${STATEDB_VERIFY_VM:-state-db-verify}
readonly VERIFY_TEMPLATE=.lima/verification.yaml
readonly MISE_VERSION=v2026.8.5
readonly MISE_SHA256_LINUX_ARM64=d2bde76b1f87ab50b6f456e05332bb02de56a6bf3c5d19343cc3661e5d294681
readonly MISE_SHA256_LINUX_X64=ee362b6d96c648e27325a8bc7ee866bde4fffc20c88c777c5eb5c3b5c6f3e226
readonly LIMA_VERSION=2.2.0
readonly MVNW=modules/mvnw

usage() {
  cat <<'EOF'
usage: ./dev <command>

  doctor          report local prerequisites
  quick           fast checks in the credential-free verification VM
  check           authoritative checks in a credential-free Lima VM
  protocol        Pulumi smoke and fault checks in that VM
  native-contract focused native-agent metadata verification in that VM
  schema          regenerate the readable PostgreSQL schema in that VM
  notices         regenerate THIRD-PARTY-NOTICES.txt in that VM
  publish-candidate build, publish, and gate this machine's architecture candidate
  ci-protocol     same protocol task on an ephemeral GitHub-hosted runner
  signoff         run check, then publish signoff/ci for the exact commit
  vm-reset        delete the disposable verification VM
  -- <command>    run a focused command in the pinned mise environment
EOF
}

fail() {
  echo "dev: $*" >&2
  exit 1
}

require_isolated() {
  [[ ${STATEDB_ISOLATED:-} == 1 ]] ||
    fail "internal verification tasks must be entered through a public ./dev command"
}

java_verify() {
  ./bin/prepare-native-agent-jvm >/dev/null
  "$MVNW" -f modules/pom.xml verify -Pnative-agent-tests
}

web_verify() {
  (
    cd modules/web
    bun install --frozen-lockfile
    bun run lint
    bun run typecheck
    bun test
  )
}

go_verify() {
  local module
  for module in tools/pulumi/api-extract tools/pulumi/verify tools/pulumi/recorder workbench/pulumi/providers/statedbsim; do
    (cd "$module" && go test ./... && go build ./...)
  done
}

release_tooling_verify() {
  ./bin/verify-release-tooling
}

publish_candidate() {
  [[ $# -eq 0 ]] || fail "publish-candidate takes no arguments"

  local registry=${STATEDB_REGISTRY:-ghcr.io/state-db/statedb}
  local candidate_registry=${STATEDB_CANDIDATE_REGISTRY:-${registry}-candidates}
  local commit commit_short arch candidate digest_json digest immutable

  [[ -z $(git status --porcelain --untracked-files=no) ]] ||
    fail "the tracked tree has uncommitted changes; a candidate must name a real commit"
  commit=$(git rev-parse HEAD)
  [[ $commit =~ ^[0-9a-f]{40}$ ]] || fail "Git returned an invalid full commit: $commit"
  commit_short=$(git rev-parse --short=7 HEAD)
  [[ $commit_short =~ ^[0-9a-f]{7,40}$ ]] || fail "Git returned an invalid short commit: $commit_short"

  arch=$(docker version --format '{{.Server.Arch}}')
  case "$arch" in
  amd64|arm64) ;;
  *) fail "unsupported Docker server architecture: $arch" ;;
  esac
  candidate="$candidate_registry:$commit-$arch"

  echo "==> building $arch candidate for $commit"
  ./bin/build-native-app-image state-db:native-ci

  [[ $(git rev-parse HEAD) == "$commit" ]] ||
    fail "HEAD changed while the candidate was building; refusing to publish"
  [[ -z $(git status --porcelain --untracked-files=no) ]] ||
    fail "the tracked tree changed while the candidate was building; refusing to publish"

  docker tag state-db:native-ci "$candidate"
  docker push "$candidate"
  digest_json=$(docker buildx imagetools inspect "$candidate" --format '{{json .Manifest.Digest}}')
  [[ $digest_json =~ ^\"sha256:[0-9a-f]{64}\"$ ]] ||
    fail "registry returned an invalid candidate digest: $digest_json"
  digest=${digest_json:1:${#digest_json}-2}
  immutable="$candidate_registry@$digest"

  # Pull and gate the immutable registry reference. Gating the local tag would not prove that a
  # remote AWS host can resolve and run the bytes that the registry accepted.
  docker pull "$immutable"
  ./bin/release-gate "$immutable" --expect-commit "$commit_short"

  echo "published $candidate"
  echo "digest    $immutable"
  echo "note      formal releases still require a successful native.yml run for this commit"
}

run_isolated_task() {
  require_isolated
  local task=${1:?internal task is required}
  shift

  case "$task" in
  quick)
    [[ $# -eq 0 ]] || fail "internal quick task takes no arguments"
    "$MVNW" -f modules/pom.xml spotless:check
    web_verify
    go_verify
    release_tooling_verify
    ;;
  check)
    [[ $# -eq 0 ]] || fail "internal check task takes no arguments"
    java_verify
    web_verify
    ./bin/generate-third-party-notices --check
    ./bin/generate-db-schema --check
    for postgres_version in 14 16 18; do
      STATEDB_SCHEMA_PG_IMAGE="postgres:${postgres_version}-alpine" \
        ./bin/generate-db-schema --check
    done
    ./bin/verify-db-schema-generator
    go_verify
    release_tooling_verify
    ;;
  notices)
    [[ $# -eq 0 ]] || fail "internal notices task takes no arguments"
    ./bin/generate-third-party-notices
    ;;
  schema)
    [[ $# -eq 0 ]] || fail "internal schema task takes no arguments"
    ./bin/generate-db-schema
    ;;
  native-contract)
    [[ $# -eq 0 ]] || fail "internal native-contract task takes no arguments"
    java_verify
    ;;
  protocol)
    local pulumi_image=pulumi/pulumi:3.234.0 arg
    for arg in "$@"; do
      case "$arg" in
      -Dpulumi.cli.image=*) pulumi_image=${arg#*=} ;;
      esac
    done
    docker pull "$pulumi_image"
    "$MVNW" -f modules/pom.xml -pl pulumi-cli-smoke -am verify \
      -Dsurefire.skip=true \
      -DskipPulumiCliSmoke=false \
      -DskipPulumiCliFaults=false \
      "$@"
    ;;
  *) fail "unsupported internal task: $task" ;;
  esac
}

guest_bootstrap() {
  require_isolated
  [[ $# -eq 5 ]] || fail "internal guest bootstrap received the wrong arguments"
  local workspace=$1 expected_mise_version=$2
  local mise_sha256_linux_arm64=$3 mise_sha256_linux_x64=$4 task=$5
  local mise_arch expected_sha mise_path actual_sha download

  cd "$workspace"
  case $(uname -m) in
  aarch64) mise_arch=arm64; expected_sha=$mise_sha256_linux_arm64 ;;
  x86_64) mise_arch=x64; expected_sha=$mise_sha256_linux_x64 ;;
  *) fail "unsupported guest architecture $(uname -m)" ;;
  esac

  mise_path="$HOME/.local/bin/mise"
  actual_sha=
  [[ ! -f $mise_path ]] || actual_sha=$(sha256sum "$mise_path" | cut -d' ' -f1)
  if [[ $actual_sha != "$expected_sha" ]]; then
    mkdir -p "$HOME/.local/bin"
    download=$(mktemp)
    trap 'rm -f "$download"' EXIT
    curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
      "https://github.com/jdx/mise/releases/download/$expected_mise_version/mise-$expected_mise_version-linux-$mise_arch" \
      -o "$download"
    printf '%s  %s\n' "$expected_sha" "$download" | sha256sum -c -
    chmod 0755 "$download"
    mv "$download" "$mise_path"
  fi

  [[ $("$mise_path" --version | awk '{print $1}') == "${expected_mise_version#v}" ]] ||
    fail "pinned mise binary reports the wrong version"

  "$mise_path" trust --yes "$workspace/mise.toml"
  "$mise_path" install --yes
  exec "$mise_path" exec -- bash "$workspace/dev" __isolated-task "$task"
}

require_mise() {
  command -v mise >/dev/null || fail "mise is required (brew install mise); expected $MISE_VERSION"
  [[ $(mise --version | awk '{print $1}') == "${MISE_VERSION#v}" ]] ||
    fail "mise $MISE_VERSION is required; found $(mise --version | head -1)"
}

vm_exists() {
  # Collected before matching rather than piped into it: `grep -q` exits at the first match, and
  # under `pipefail` the SIGPIPE that kills `limactl` (141) becomes the function's status. The VM
  # name sorts first, so the match is immediate and the race is frequent — the failure reads as
  # "no VM", and ensure_vm then tries to create one that already exists and aborts.
  local names
  names=$(limactl list --format '{{.Name}}' 2>/dev/null) || return 1
  grep -Fxq "$VERIFY_VM" <<<"$names"
}

ensure_vm() {
  local created=false
  command -v limactl >/dev/null || fail "Lima is required for isolated checks (brew install lima)"
  [[ $(limactl --version | awk '{print $3}') == "$LIMA_VERSION" ]] ||
    fail "Lima $LIMA_VERSION is required; found $(limactl --version)"
  if ! vm_exists; then
    created=true
    echo "==> creating credential-free verification VM $VERIFY_VM"
    limactl start --tty=false --name "$VERIFY_VM" \
      --cpus 4 --memory 8 --disk 60 "$VERIFY_TEMPLATE"
  else
    limactl start "$VERIFY_VM" >/dev/null
  fi
  [[ $(limactl list "$VERIFY_VM" --format '{{json .Config.Mounts}}') == '[]' ]] ||
    fail "$VERIFY_VM has host mounts; delete it with ./dev vm-reset before verification"
  limactl shell "$VERIFY_VM" test -f /etc/state-db-verification-vm ||
    fail "$VERIFY_VM predates the hardened VM profile; recreate it with ./dev vm-reset"
  ! limactl shell "$VERIFY_VM" sudo -n true >/dev/null 2>&1 ||
    fail "$VERIFY_VM permits guest sudo; recreate it with ./dev vm-reset"

  local expected_hash actual_hash guest_home fingerprint
  expected_hash=$(git hash-object "$VERIFY_TEMPLATE")
  guest_home=$(limactl shell "$VERIFY_VM" printenv HOME)
  fingerprint="$guest_home/.state-db-verification-template"
  if $created; then
    limactl shell "$VERIFY_VM" sh -c 'umask 077; printf "%s\n" "$1" >"$2"' \
      sh "$expected_hash" "$fingerprint"
  fi
  actual_hash=$(limactl shell "$VERIFY_VM" cat "$fingerprint" 2>/dev/null || true)
  [[ $actual_hash == "$expected_hash" ]] ||
    fail "$VERIFY_TEMPLATE changed since $VERIFY_VM was created; recreate it with ./dev vm-reset"
}

copy_workspace() {
  local guest_dir=$1
  limactl shell "$VERIFY_VM" rm -rf "$guest_dir"
  limactl shell "$VERIFY_VM" mkdir -p "$guest_dir"
  # Copy only Git-visible source. This excludes .git, ignored build output/caches, and local agent
  # state. COPYFILE_DISABLE prevents macOS xattrs from producing enormous guest-tar warning logs.
  COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata --null -cf - -T <(
    git ls-files -z -co --exclude-standard |
      while IFS= read -r -d '' file; do
        [[ $file == .claude/* ]] && continue
        [[ -e $file || -L $file ]] && printf '%s\0' "$file"
      done
  ) | limactl shell "$VERIFY_VM" tar -xf - -C "$guest_dir"
}

run_isolated() {
  local task=$1
  ensure_vm
  local guest_dir guest_home guest_uid
  guest_dir=/tmp/state-db-workspace
  guest_home=$(limactl shell "$VERIFY_VM" printenv HOME)
  guest_uid=$(limactl shell "$VERIFY_VM" id -u)
  echo "==> copying workspace into $VERIFY_VM (no host mounts)"
  copy_workspace "$guest_dir"
  echo "==> running $task with a guest-only HOME and Docker daemon"
  limactl shell "$VERIFY_VM" env -i \
    HOME="$guest_home" \
    USER=builder \
    PATH="$guest_home/.local/bin:/usr/local/bin:/usr/bin:/bin" \
    LANG=C.UTF-8 \
    XDG_RUNTIME_DIR="/run/user/$guest_uid" \
    DOCKER_HOST="unix:///run/user/$guest_uid/docker.sock" \
    STATEDB_ISOLATED=1 \
    bash "$guest_dir/dev" __guest-bootstrap "$guest_dir" "$MISE_VERSION" \
      "$MISE_SHA256_LINUX_ARM64" "$MISE_SHA256_LINUX_X64" "$task"
}

reset_vm() {
  if vm_exists; then
    limactl stop "$VERIFY_VM" >/dev/null 2>&1 || true
    limactl delete "$VERIFY_VM"
  fi
}

doctor() {
  local failed=false
  printf '%-12s %s\n' git "$(git --version)"
  if command -v mise >/dev/null; then
    printf '%-12s %s\n' mise "$(mise --version | head -1)"
  else
    printf '%-12s %s\n' mise 'missing (brew install mise)'
    failed=true
  fi
  if command -v limactl >/dev/null; then
    printf '%-12s %s\n' lima "$(limactl --version) (required $LIMA_VERSION)"
  else
    printf '%-12s %s\n' lima 'missing (brew install lima)'
    failed=true
  fi
  if command -v gh >/dev/null; then
    printf '%-12s %s\n' gh "$(gh --version | head -1)"
  else
    printf '%-12s %s\n' gh 'missing (only required for signoff/release)'
  fi
  if $failed; then
    return 1
  fi
  return 0
}

command=${1:-help}
shift || true
case "$command" in
__guest-bootstrap) guest_bootstrap "$@" ;;
__isolated-task) run_isolated_task "$@" ;;
doctor) doctor ;;
publish-candidate) publish_candidate "$@" ;;
quick|check|protocol|native-contract)
  [[ $# -eq 0 ]] || fail "$command takes no arguments"
  run_isolated "$command"
  ;;
notices|schema)
  [[ $# -eq 0 ]] || fail "$command takes no arguments"
  run_isolated "$command"
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' EXIT
  if [[ $command == notices ]]; then
    limactl shell "$VERIFY_VM" cat /tmp/state-db-workspace/THIRD-PARTY-NOTICES.txt >"$tmp"
    [[ -s $tmp ]] || fail "the guest produced an empty THIRD-PARTY-NOTICES.txt"
    IFS= read -r notices_header <"$tmp"
    [[ $notices_header == 'state-db third-party notices' ]] ||
      fail "the guest produced an invalid THIRD-PARTY-NOTICES.txt"
    mv "$tmp" THIRD-PARTY-NOTICES.txt
  else
    limactl shell "$VERIFY_VM" cat /tmp/state-db-workspace/design/schema.sql >"$tmp"
    [[ -s $tmp ]] || fail "the guest produced an empty design/schema.sql"
    IFS= read -r schema_header <"$tmp"
    [[ $schema_header == '-- Generated by bin/generate-db-schema. Do not edit this file.' ]] ||
      fail "the guest produced an invalid design/schema.sql"
    mv "$tmp" design/schema.sql
  fi
  ;;
ci-protocol)
  [[ ${GITHUB_ACTIONS:-} == true ]] || fail "ci-protocol is only for a GitHub-hosted runner"
  [[ $# -le 1 ]] || fail "ci-protocol accepts at most one Pulumi image"
  require_mise
  export STATEDB_ISOLATED=1
  if [[ $# -eq 1 ]]; then
    exec mise exec -- bash ./dev __isolated-task protocol "-Dpulumi.cli.image=$1"
  fi
  exec mise exec -- bash ./dev __isolated-task protocol
  ;;
signoff)
  [[ $# -eq 0 ]] || fail "signoff takes no arguments"
  command -v gh >/dev/null || fail "gh is required for signoff"
  gh extension list | grep -q 'basecamp/gh-signoff' ||
    fail "install gh-signoff: gh extension install basecamp/gh-signoff"
  [[ -z $(git status --porcelain) ]] || fail "signoff requires a clean tree"
  sha=$(git rev-parse HEAD)
  reset_vm
  run_isolated check
  [[ $(git rev-parse HEAD) == "$sha" && -z $(git status --porcelain) ]] ||
    fail "HEAD or the working tree changed while verification was running; refusing signoff"
  gh signoff ci
  ;;
vm-reset)
  command -v limactl >/dev/null || fail "Lima is not installed"
  reset_vm
  ;;
--)
  require_mise
  [[ $# -gt 0 ]] || fail "./dev -- needs a command"
  exec mise exec -- "$@"
  ;;
help|-h|--help) usage ;;
*) usage >&2; fail "unknown command: $command" ;;
esac
