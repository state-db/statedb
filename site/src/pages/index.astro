    <script>
      const tabs = document.querySelectorAll<HTMLButtonElement>(".term-tabs [role=tab]");
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => {
            const selected = t === tab;
            t.setAttribute("aria-selected", String(selected));
            const panel = document.getElementById(t.dataset.panel ?? "");
            if (panel) panel.hidden = !selected;
          });
        });
      });

      /* The hero terminal replays on a loop. Every CSS delay on it is absolute
         from cycle start, so replaying is just rewinding the whole timeline to
         zero. There is no class toggling or reflow hack. Only the period below
         must stay in sync. It only runs while the terminal is on screen. */
      const term = document.querySelector<HTMLElement>(".deploy-terminal");
      const stillMotion = matchMedia("(prefers-reduced-motion: reduce)");

      if (term && !stillMotion.matches) {
        const TERMINAL_CYCLE_MS = 10008;
        let timer: number | undefined;

        term.dataset.loop = "on";

        const replay = () => {
          term.getAnimations({ subtree: true }).forEach((a) => {
            const effect = a.effect;
            if (
              effect instanceof KeyframeEffect &&
              effect.target === term &&
              !effect.pseudoElement
            ) {
              return;
            }
            a.currentTime = 0;
          });
        };

        new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) {
              replay();
              timer ??= window.setInterval(replay, TERMINAL_CYCLE_MS);
            } else if (timer !== undefined) {
              clearInterval(timer);
              timer = undefined;
            }
          },
          { threshold: 0.2 },
        ).observe(term);
      }
    </script>
