---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/jetbrains-mono";
import "../styles/ocean.css";
import logoDark from "../assets/statedb-logo-dark.svg";
import mascot from "../assets/statedb-mascot.png";
import testWall from "../data/test-wall.json";

const github = "https://github.com/state-db/statedb";

const scope = [
  "No deployment runner. No access to your repositories or cloud accounts",
  "No built-in AI or agent with state-writing privileges",
];

const tiers = [
  {
    label: "WIRE CONTRACT",
    claim: "Recorded CLI sessions catch protocol drift",
    body: "Recorded exchanges are replayed against statedb. Status codes and covered JSON responses are checked after dynamic fields are normalized.",
  },
  {
    label: "INTEGRITY CHECKS",
    claim: "Pulumi verifies assembled checkpoints",
    body: "Focused assembly and failure tests run checkpoints through Pulumi's own snapshot integrity verifier. If the verifier rejects one, the test fails.",
  },
  {
    label: "REAL CLI",
    claim: "Released binaries run complete workflows",
    body: "The release gate runs real Pulumi binaries against statedb to test stacks, updates, tags, history, stack references, secrets, and recovery scenarios.",
  },
  {
    label: "FAULT TESTS",
    claim: "Failure paths get their own test suite",
    body: "Tests kill the CLI mid-update, race concurrent runs, stop deployments partway, and tamper with imports. Each one checks what the operator sees and what remains in PostgreSQL.",
  },
];

/* Test-wall rows are generated from the compatibility suite itself. Run
   `bun run generate:test-wall` after adding a session, class, or scenario. */
const wallRow = (chips: { label: string; path: string }[], reverse: boolean) => ({
  chips: chips.map(({ label, path }) => ({ label, href: `${github}/blob/main/${path}` })),
  // A loop lasts as long as its content is wide, so rows keep one reading
  // speed however many chips the generator emits.
  dur: `${Math.round(chips.reduce((n, c) => n + c.label.length, 0) * 0.3)}s`,
  reverse,
});

const wallRows = [
  wallRow(testWall.sessions, false),
  wallRow(testWall.classes, true),
  wallRow(testWall.scenarios, false),
];

const access = [
  {
    title: "OIDC sign-in",
    body: "Connect Okta, Microsoft Entra, Keycloak, Google, or another OpenID Connect provider. Configure database-backed providers in the console without redeploying. Environment-seeded providers remain deployment-managed.",
  },
  {
    title: "Organization roles",
    body: "Assign owner, member, viewer, or guest in each organization. The same person can hold a different role in each one. Site administrators are configured separately.",
  },
  {
    title: "Per-stack grants",
    body: "Per-stack grants are enforced today. The management UI is still in progress, so administrators manage grants in PostgreSQL for now.",
  },
  {
    title: "Cedar policies",
    body: "Authorization is built on Cedar. The built-in role, service, and guardrail policies are public.",
  },
  {
    title: "Service accounts",
    body: "Create and revoke long-lived automation tokens in the console. CI supplies them through PULUMI_ACCESS_TOKEN.",
  },
  {
    title: "Native CLI login",
    body: "Interactive pulumi login opens your browser for OIDC sign-in and approval, then returns a token to the CLI.",
  },
];

const operating = [
  {
    q: "Backups",
    a: "State, history, identities, token hashes, policy grants, and the service-secrets keyset live in PostgreSQL. Back up the whole database with your existing process.",
  },
  {
    q: "Upgrades",
    a: "Database migrations run before statedb accepts traffic. Flyway's PostgreSQL lock prevents replicas from applying them at the same time.",
  },
  {
    q: "Replicas",
    a: "Update leases live in PostgreSQL, so any replica can accept a request. Share one session encryption secret across pods so browser sessions work everywhere.",
  },
  {
    q: "Requirements",
    a: "Run one service with PostgreSQL 14 or newer and LZ4 support. There is no queue, object store, or second application process. The test matrix covers PostgreSQL 14, 16, and 18.",
  },
  {
    q: "Failure recovery",
    a: "If statedb is offline, Pulumi cannot read or update state. State remains in PostgreSQL. An interrupted stack becomes available when its lease expires.",
  },
  {
    q: "Air-gapped operation",
    a: "At runtime, statedb connects to PostgreSQL and an identity provider reachable inside your network. It does not depend on an external control plane.",
  },
];

const security = [
  {
    title: "Source",
    body: "The service, database migrations, Cedar policies, console, and compatibility tests share one public repository. Trace a state write from its API request to the rows persisted in PostgreSQL.",
  },
  {
    title: "Secrets",
    body: "The service secrets provider uses Google Tink with AES-GCM. Ciphertext from one stack will not decrypt in another. Passphrase and cloud KMS providers stay client-side and work unchanged.",
  },
  {
    title: "Key handling",
    body: "On first boot, statedb generates an encryption keyset and stores it in PostgreSQL, separate from checkpoint data. This protects exposed checkpoints and dumps that omit the keyset. It does not protect a database compromise that includes the keyset.",
  },
  {
    title: "Data residency",
    body: "Stored state, history, identities, and token hashes remain in your PostgreSQL database. statedb exposes Prometheus metrics locally and does not phone home.",
  },
  {
    title: "Break-glass access",
    body: "Emergency local login is disabled by default and limited to loopback unless you explicitly permit remote access. Enabling any OIDC provider disables it.",
  },
  {
    title: "Dependencies",
    body: "The repository includes static-analysis and dependency-scanning targets. SECURITY.md publicly documents how to report vulnerabilities privately.",
  },
];

const faq = [
  {
    q: "What happens if statedb is unavailable?",
    a: "Pulumi cannot read or update state until statedb returns. Your state remains in PostgreSQL. When statedb is available, you can export a standard checkpoint for another backend.",
  },
  {
    q: "How does statedb differ from Pulumi Cloud?",
    a: "Pulumi Cloud is a broader managed platform. statedb is a narrower self-hosted backend and console. It manages state and access without running your deployments.",
  },
  {
    q: "Does our CI/CD have to change?",
    a: "Your Pulumi steps do not. Keep preview, up, refresh, and destroy. Change the backend URL and pass a service-account token through PULUMI_ACCESS_TOKEN.",
  },
  {
    q: "Is OpenTofu supported?",
    a: "Not yet. Support for its HTTP backend protocol is planned.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>statedb: self-host Pulumi state and keep the console</title>
    <meta
      name="description"
      content="Run a Pulumi-compatible state backend and console in your network. Keep state in PostgreSQL while preserving the core Pulumi CLI workflow your team already uses."
    />
    <meta property="og:title" content="statedb: self-host your Pulumi state" />
    <meta
      property="og:description"
      content="Keep Pulumi state in your PostgreSQL database and give your team a console to inspect it."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://statedb.app/" />
    <meta property="og:image" content="https://statedb.app/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="statedb: self-host your Pulumi state" />
    <meta
      name="twitter:description"
      content="Keep Pulumi state in your PostgreSQL database and give your team a console to inspect it."
    />
    <meta name="twitter:image" content="https://statedb.app/og.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="nav">
      <div class="shell nav-row">
        <a class="nav-logo" href="/">
          <img src={logoDark.src} alt="statedb" width="150" height="42" />
        </a>
        <nav class="nav-links" aria-label="Main">
          <a href="#security">Security</a>
          <a href="/docs/">Docs</a>
          <a href={github}>GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <h1>
              The open-source, self-hosted state backend with
              <span>a real console</span>
            </h1>
            <p class="hero-sub">
              Replace bare object storage with a real state service: locking, history,
              access control, and a console, all inside your network.
            </p>
            <div class="cta-row hero-actions">
              <a class="btn btn-solid" href="/docs/quickstart/">Quickstart</a>
              <a class="btn btn-hero-outline" href={github}>GitHub</a>
            </div>
            <div class="term">
              <div class="term-tabs" role="tablist" aria-label="Choose your CLI">
                <button role="tab" aria-selected="true" aria-controls="term-pulumi" data-panel="term-pulumi">
                  Pulumi CLI
                </button>
                <button role="tab" aria-selected="false" aria-controls="term-tofu" data-panel="term-tofu">
                  OpenTofu <span class="soon">planned</span>
                </button>
              </div>
              <div class="terminal" id="term-pulumi" role="tabpanel">
                <span class="t-line"><span class="t-prompt">$</span> pulumi login https://state.acme/pulumi</span>
                <span class="t-line t-out">Logged in to state.acme</span>
              </div>
              <div class="terminal" id="term-tofu" role="tabpanel" hidden>
                <span class="t-line t-comment"># OpenTofu support is planned. It is not available today.</span>
                <span class="t-line t-comment"># Its HTTP backend protocol is the intended target.</span>
                <span class="t-line t-comment"># Follow progress: github.com/state-db/statedb</span>
              </div>
            </div>
            <p class="terminal-caption">
              No plugin. No patched CLI. Change the backend URL and carry on.
            </p>
          </div>

          <aside class="deploy-terminal" aria-label="Terminal showing a Pulumi preview using statedb">
            <div class="terminal-chrome" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <strong>acme / payments-api / prod</strong>
            </div>
            <div class="terminal-screen">
              <div class="terminal-scrollback">
                <span class="term-row term-command" style="--d: 60ms; --ch: 39; --hold: 220ms"
                  ><span class="t-prompt">$</span><span class="cmd"
                    >export PULUMI_CONSOLE_DOMAIN=state.acme</span
                  ></span
                >
                <span class="term-row term-command" style="--d: 730ms; --ch: 51; --hold: 220ms"
                  ><span class="t-prompt">$</span><span class="cmd"
                    >export PULUMI_BACKEND_URL=https://state.acme/pulumi</span
                  ></span
                >
                <span class="term-row term-command" style="--d: 1508ms; --ch: 34; --hold: 520ms"
                  ><span class="t-prompt">$</span><span class="cmd"
                    >pulumi login "$PULUMI_BACKEND_URL"</span
                  ></span
                >
                <span class="term-row t-out" style="--d: 2334ms"
                  >Logged in to https://state.acme/pulumi as platform-admin</span
                >
                <span class="term-row term-command" style="--d: 2598ms; --ch: 24; --hold: 200ms"
                  ><span class="t-prompt">$</span><span class="cmd"
                    >pulumi stack select prod</span
                  ></span
                >
                <span class="term-row term-command" style="--d: 3059ms; --ch: 14; --hold: 130ms"
                  ><span class="t-prompt">$</span><span class="cmd">pulumi preview</span></span
                >
                <span class="term-row t-blank" style="--d: 3318ms" aria-hidden="true"></span>
                <span class="term-row t-heading" style="--d: 3398ms"
                  ><span class="spinner" aria-hidden="true"></span>Previewing update (prod)</span
                >
                <span class="term-row t-blank" style="--d: 3738ms" aria-hidden="true"></span>
                <span class="term-row t-link" style="--d: 3818ms">View in Browser: https://state.acme/acme/payments-api/prod/previews/00000000-0000-4000-8000-000000000041</span>
                <span class="term-row t-blank" style="--d: 3978ms" aria-hidden="true"></span>
                <span class="term-row t-table t-table-head" style="--d: 4058ms"><span>Type</span><span>Name</span><span>Plan</span></span>
                <span class="term-row t-table t-resource" style="--d: 4158ms"><span>+ pulumi:pulumi:Stack</span><span>payments-api-prod</span><span>create</span></span>
                <span class="term-row t-table t-resource" style="--d: 4258ms"><span>+ |- aws:rds:Cluster</span><span>payments-db</span><span>create</span></span>
                <span class="term-row t-table t-resource" style="--d: 4358ms"><span>+ |- aws:ecs:Service</span><span>api</span><span>create</span></span>
                <span class="term-row t-table t-resource" style="--d: 4458ms"><span>+ |- aws:sqs:Queue</span><span>billing-events</span><span>create</span></span>
                <span class="term-row t-table t-resource" style="--d: 4558ms"><span>+ |- aws:cloudwatch:LogGroup</span><span>api-logs</span><span>create</span></span>
                <span class="term-row t-table t-resource" style="--d: 4658ms"><span>+ `- random:index:RandomPassword</span><span>db-password</span><span>create</span></span>
                <span class="term-row t-blank" style="--d: 4758ms" aria-hidden="true"></span>
                <span class="term-row t-section" style="--d: 4838ms">Resources:</span>
                <span class="term-row t-summary" style="--d: 4958ms">+ 6 to create<span class="terminal-cursor" aria-hidden="true"></span></span>
              </div>
              <div class="terminal-flash" aria-hidden="true"></div>
            </div>
          </aside>
        </div>
      </section>

      <!-- SCOPE -->
      <section class="scope">
        <div class="shell">
          <h2>State management, without a new delivery platform</h2>
          <p class="section-lead">
            statedb handles state, locking, history, access control, and the console. Your
            repositories, cloud accounts, runners, and deployment workflows stay where they are.
          </p>
          <ul class="scope-list">
            {scope.map((item) => (
              <li class="scope-no">{item}</li>
            ))}
            <li class="scope-yes">One service for state, locking, history, access control, and the console</li>
          </ul>
        </div>
      </section>

      <!-- CONSOLE -->
      <section class="console">
        <div class="shell">
          <h2>See what is in your stacks</h2>
          <p class="section-lead">
            Browse the organizations, projects, and stacks you can access. Inspect resources,
            outputs, and update history without unpacking checkpoint files.
          </p>

          <figure class="shot shot-main">
            <div class="shot-frame">
              <div class="shot-chrome" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <strong>statedb.acme.internal/console</strong>
              </div>
              <div
                class="mock mock-stacks"
                role="img"
                aria-label="statedb console stacks view: the acme organization's projects and stacks with their latest runs"
              >
                <aside class="mock-side" aria-hidden="true">
                  <span class="mock-logo">statedb</span>
                  <span class="mock-nav is-active">Stacks</span>
                  <span class="mock-nav">Tokens</span>
                  <span class="mock-nav-label">Manage</span>
                  <span class="mock-nav">Providers</span>
                  <span class="mock-nav">Orgs</span>
                  <span class="mock-nav">Users</span>
                  <span class="mock-nav">Operations</span>
                </aside>
                <div class="mock-main" aria-hidden="true">
                  <div class="mock-head">
                    <span class="mock-title">Stacks</span>
                    <span class="mock-sub">3 projects &middot; 6 stacks</span>
                  </div>
                  <div class="mock-stats">
                    <div class="mock-stat"><span>Resources in latest state</span><strong>132</strong></div>
                    <div class="mock-stat"><span>Failed updates</span><strong>0</strong></div>
                    <div class="mock-stat"><span>Active updates</span><strong>1</strong></div>
                  </div>
                  <div class="mock-table">
                    <div class="mock-row mock-row-head">
                      <span>Stack</span><span>Last update</span><span class="num">Resources</span><span>Status</span>
                    </div>
                    <div class="mock-row mock-row-project">
                      <span>acme / payments-api</span><span></span><span class="num">3 stacks</span><span>34 resources</span>
                    </div>
                    <div class="mock-row">
                      <span>prod</span>
                      <span><span class="mchip mchip-ok">succeeded</span> 2h ago &middot; v41</span>
                      <span class="num">12</span>
                      <span><span class="mchip mchip-idle">idle</span></span>
                    </div>
                    <div class="mock-row">
                      <span>staging</span>
                      <span><span class="mchip mchip-ok">succeeded</span> 5h ago &middot; v38</span>
                      <span class="num">12</span>
                      <span><span class="mchip mchip-idle">idle</span></span>
                    </div>
                    <div class="mock-row">
                      <span>dev</span>
                      <span><span class="mchip mchip-run">running</span> now &middot; v112</span>
                      <span class="num">10</span>
                      <span><span class="mchip mchip-run">updating</span></span>
                    </div>
                    <div class="mock-row mock-row-project">
                      <span>acme / identity</span><span></span><span class="num">1 stack</span><span>6 resources</span>
                    </div>
                    <div class="mock-row">
                      <span>prod</span>
                      <span><span class="mchip mchip-ok">succeeded</span> 3d ago &middot; v17</span>
                      <span class="num">6</span>
                      <span><span class="mchip mchip-idle">idle</span></span>
                    </div>
                    <div class="mock-row mock-row-project">
                      <span>acme / data-platform</span><span></span><span class="num">2 stacks</span><span>92 resources</span>
                    </div>
                    <div class="mock-row">
                      <span>prod</span>
                      <span><span class="mchip mchip-ok">succeeded</span> 1d ago &middot; v26</span>
                      <span class="num">48</span>
                      <span><span class="mchip mchip-idle">idle</span></span>
                    </div>
                    <div class="mock-row">
                      <span>staging</span>
                      <span><span class="mchip mchip-ok">succeeded</span> 1d ago &middot; v25</span>
                      <span class="num">44</span>
                      <span><span class="mchip mchip-idle">idle</span></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <figcaption>
              <span class="shot-label">Stacks</span>
              Every project and stack you can access, with its latest run, resource count,
              and status.
            </figcaption>
          </figure>

          <div class="console-details">
            <figure class="shot">
              <div class="shot-frame">
                <div
                  class="mock mock-panel"
                  role="img"
                  aria-label="statedb console resources view: the current resources of the payments-api prod stack"
                >
                  <div class="mock-panel-head" aria-hidden="true">
                    <span class="mock-crumb">acme / payments-api / prod</span>
                    <span class="mock-tabs">
                      <span class="is-active">Resources</span><span>Outputs</span><span>Activity</span>
                    </span>
                  </div>
                  <div class="mock-toolbar" aria-hidden="true">
                    <span class="mock-search">Filter by type or name&hellip;</span>
                    <span class="mock-toggle"><span class="is-active">Flat</span><span>Tree</span></span>
                  </div>
                  <div class="mock-table" aria-hidden="true">
                    <div class="mock-row mock-row-res mock-row-head">
                      <span>Type</span><span>Name</span><span>Provider</span>
                    </div>
                    <div class="mock-row mock-row-res">
                      <span class="mono">pulumi:pulumi:Stack</span><span>payments-api-prod</span><span>pulumi</span>
                    </div>
                    <div class="mock-row mock-row-res">
                      <span class="mono">aws:rds:Cluster</span><span>payments-db</span><span>aws</span>
                    </div>
                    <div class="mock-row mock-row-res">
                      <span class="mono">aws:ecs:Service</span><span>api</span><span>aws</span>
                    </div>
                    <div class="mock-row mock-row-res">
                      <span class="mono">aws:sqs:Queue</span><span>billing-events</span><span>aws</span>
                    </div>
                    <div class="mock-row mock-row-res">
                      <span class="mono">aws:cloudwatch:LogGroup</span><span>api-logs</span><span>aws</span>
                    </div>
                    <div class="mock-row mock-row-res">
                      <span class="mono">random:index:RandomPassword</span><span>db-password</span><span>random</span>
                    </div>
                  </div>
                </div>
              </div>
              <figcaption>
                <span class="shot-label">Resources</span>
                Inspect current resources as a flat list or tree, then filter by type or name.
              </figcaption>
            </figure>
            <figure class="shot">
              <div class="shot-frame">
                <div
                  class="mock mock-panel"
                  role="img"
                  aria-label="statedb console activity view: the update history of the payments-api prod stack"
                >
                  <div class="mock-panel-head" aria-hidden="true">
                    <span class="mock-crumb">acme / payments-api / prod</span>
                    <span class="mock-tabs">
                      <span>Resources</span><span>Outputs</span><span class="is-active">Activity</span>
                    </span>
                  </div>
                  <div class="mock-toolbar" aria-hidden="true">
                    <span class="mock-select">All kinds &#9662;</span>
                    <span class="mock-select">All statuses &#9662;</span>
                  </div>
                  <div class="mock-table" aria-hidden="true">
                    <div class="mock-row mock-row-act mock-row-head">
                      <span>Version</span><span>Status</span><span>Message</span><span>Changes</span><span class="num">Duration</span>
                    </div>
                    <div class="mock-row mock-row-act">
                      <span class="mono">v41</span>
                      <span><span class="mchip mchip-ok">succeeded</span></span>
                      <span>Scale api service</span>
                      <span><span class="mchip mchip-diff">+2</span></span>
                      <span class="num">34s</span>
                    </div>
                    <div class="mock-row mock-row-act">
                      <span class="mono">v40</span>
                      <span><span class="mchip mchip-ok">succeeded</span></span>
                      <span>Rotate db-password</span>
                      <span><span class="mchip mchip-diff">~1</span></span>
                      <span class="num">12s</span>
                    </div>
                    <div class="mock-row mock-row-act">
                      <span class="mono">v39</span>
                      <span><span class="mchip mchip-ok">succeeded</span></span>
                      <span>Scheduled drift check</span>
                      <span>no changes</span>
                      <span class="num">8s</span>
                    </div>
                    <div class="mock-row mock-row-act">
                      <span class="mono">v38</span>
                      <span><span class="mchip mchip-ok">succeeded</span></span>
                      <span>Add billing-events DLQ</span>
                      <span><span class="mchip mchip-diff">+1</span></span>
                      <span class="num">26s</span>
                    </div>
                    <div class="mock-row mock-row-act">
                      <span class="mono">v37</span>
                      <span><span class="mchip mchip-ok">succeeded</span></span>
                      <span>Bump api image</span>
                      <span><span class="mchip mchip-diff">~1</span></span>
                      <span class="num">41s</span>
                    </div>
                    <div class="mock-row mock-row-act">
                      <span class="mono">v36</span>
                      <span><span class="mchip mchip-ok">succeeded</span></span>
                      <span>Tighten security groups</span>
                      <span><span class="mchip mchip-diff">~2</span></span>
                      <span class="num">33s</span>
                    </div>
                  </div>
                </div>
              </div>
              <figcaption>
                <span class="shot-label">Update history</span>
                Review every update, including its changes, duration, and result.
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- COMPATIBILITY -->
      <section class="proof" id="compatibility">
        <div class="shell">
          <p class="kicker">Compatibility</p>
          <h2>We test with the real Pulumi CLI</h2>
          <p class="section-lead">
            Protocol documentation is not enough. statedb replays recorded traffic, checks
            assembled checkpoints, and runs released Pulumi binaries through normal and
            failure workflows.
          </p>
          <p class="proof-badge">Release gate: Pulumi CLI 3.234.0 and 3.259.0</p>
          <div class="tier-list">
            {tiers.map((tier) => (
              <div class="tier">
                <span class="tier-label">{tier.label}</span>
                <p class="tier-claim">{tier.claim}</p>
                <p>{tier.body}</p>
              </div>
            ))}
          </div>
