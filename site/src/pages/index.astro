    color: var(--text-on-ink);
    font-size: var(--rowfs);
    line-height: var(--row);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    position: relative;
    z-index: 1;
  }

  .term-command {
    color: #ffffff;
  }

  .cmd {
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    white-space: pre;
    vertical-align: bottom;
    border-right: 0.5ch solid transparent;
  }

  .spinner {
    display: inline-block;
    width: 2ch;
    color: var(--tide-lit);
    font-weight: 400;
  }

  .spinner::before {
    content: "⠋";
  }

  .t-heading,
  .t-section {
    color: #ffffff;
    font-weight: 700;
  }

  .t-table {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr) minmax(3.5rem, 0.35fr);
    gap: 0.9rem;
    align-items: baseline;
  }

  .t-table span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .t-table-head {
    color: var(--tide-lit);
    text-decoration: underline;
    text-underline-offset: 0.18rem;
  }

  .t-resource {
    color: var(--muted-on-ink);
  }

  .t-resource span:first-child,
  .t-resource span:last-child {
    color: var(--kelp-lit);
  }

  .t-resource span:nth-child(2) {
    color: var(--text-on-ink);
  }

  .t-summary {
    color: var(--kelp-lit);
    font-weight: 700;
    padding-left: 1.3rem;
  }

  .t-link {
    --rows: 2;
    max-width: 60ch;
    color: var(--biolume);
    white-space: normal;
    overflow-wrap: anywhere;
    text-overflow: clip;
  }

  .terminal-cursor {
    display: inline-block;
    width: 0.62rem;
    height: 1em;
    margin-left: 0.52rem;
    vertical-align: -0.16em;
    background: var(--biolume);
    box-shadow: 0 0 16px rgba(63, 211, 232, 0.3);
  }

  @media (prefers-reduced-motion: no-preference) {
    .terminal-scrollback {
      animation: terminal-scroll 1100ms cubic-bezier(0.33, 0.1, 0.2, 1) 4368ms both;
    }

    .deploy-terminal[data-loop] .terminal-scrollback {
      animation:
        terminal-scroll 1100ms cubic-bezier(0.33, 0.1, 0.2, 1) 4368ms both,
        terminal-clear 1ms linear 9808ms forwards;
    }

    .deploy-terminal[data-loop] .terminal-flash {
      animation: screen-flash 260ms ease-out 9748ms both;
    }

    .terminal-scrollback .term-row {
      opacity: 0;
      animation: terminal-row-in 220ms ease-out var(--d) both;
    }

    .terminal-scrollback .term-command {
      animation-duration: 90ms;
    }

    .term-command .cmd {
      animation:
        terminal-type calc(var(--ch) * 9ms) steps(22, end) var(--d) both,
        caret-blink 880ms steps(2, jump-none) var(--d) infinite,
        caret-off 1ms linear calc(var(--d) + var(--ch) * 9ms + var(--hold, 200ms)) forwards;
    }

    .spinner::before {
      animation: spinner-frames 640ms steps(1, end) 3398ms infinite;
    }

    .spinner {
      animation: spinner-done 140ms ease-out 3938ms forwards;
    }

    .t-resource span:first-child {
      animation: marker-land 620ms ease-out var(--d) both;
    }

    .t-link {
      animation:
        terminal-row-in 220ms ease-out var(--d) both,
        link-glow 1400ms ease-out calc(var(--d) + 260ms) both;
    }

    .terminal-cursor {
      animation: cursor-blink 1s steps(2, jump-none) 5468ms infinite;
    }

    .deploy-terminal::after {
      animation: glass-sheen 2600ms cubic-bezier(0.4, 0, 0.5, 1) 5718ms both;
    }

    @keyframes glass-sheen {
      from { background-position: 120% 0; }
      to { background-position: -60% 0; }
    }

    @keyframes terminal-scroll {
      from { transform: translateY(0); }
      to { transform: translateY(calc((var(--visible) - var(--total)) * var(--row))); }
    }

    @keyframes terminal-clear {
      to {
        opacity: 0;
        transform: translateY(calc((var(--visible) - var(--total)) * var(--row)));
      }
    }

    @keyframes screen-flash {
      0% { opacity: 0; }
      23% { opacity: 1; }
      100% { opacity: 0; }
    }

    @keyframes terminal-row-in {
      from { opacity: 0; transform: translateY(0.3rem); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes terminal-type {
      from { width: 0; }
      to { width: calc(var(--ch) * 1ch + 1.1ch); }
    }

    @keyframes caret-blink {
      from { border-right-color: var(--biolume); }
      to { border-right-color: rgba(63, 211, 232, 0.12); }
    }

    @keyframes caret-off {
      to { border-right-color: transparent; }
    }

    @keyframes spinner-frames {
      0% { content: "⠋"; }
      12.5% { content: "⠙"; }
      25% { content: "⠹"; }
      37.5% { content: "⠸"; }
      50% { content: "⠼"; }
      62.5% { content: "⠴"; }
      75% { content: "⠦"; }
      87.5% { content: "⠧"; }
    }

    @keyframes spinner-done {
      to { opacity: 0; }
    }

    @keyframes marker-land {
      0% { color: #ffffff; text-shadow: 0 0 12px rgba(126, 224, 160, 0.55); }
      100% { color: var(--kelp-lit); text-shadow: 0 0 0 rgba(126, 224, 160, 0); }
    }

    @keyframes cursor-blink {
      0%, 48% { opacity: 1; }
      49%, 100% { opacity: 0.18; }
    }

    @keyframes link-glow {
      0% { text-shadow: 0 0 0 rgba(63, 211, 232, 0); }
      40% { text-shadow: 0 0 18px rgba(63, 211, 232, 0.42); }
      100% { text-shadow: 0 0 0 rgba(63, 211, 232, 0); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deploy-terminal {
      --visible: var(--total);
    }

    .terminal-cursor {
      display: none;
    }

    .spinner {
      visibility: hidden;
    }
  }

  /* ---------- section rhythm ---------- */

  .scope,
  .proof,
  .console,
  .access,
  .ops,
  .security,
  .adopt,
  .faq,
  .close {
    padding-block: clamp(5rem, 7vw, 6.5rem);
  }

  .kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue);
    margin: 0 0 0.9rem;
  }

  .section-lead {
    color: var(--muted);
    max-width: 62ch;
  }

  .section-foot {
    margin-top: 2rem;
    margin-bottom: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .band-sub {
    color: var(--muted-on-ink);
    max-width: 52ch;
  }

  /* ---------- scope ---------- */

  .scope-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    max-width: 46rem;
  }

  .scope-list li {
    font-family: var(--display);
    font-size: 1.05rem;
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }

  .scope-list li::before {
    font-family: var(--mono);
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .scope-no {
    color: var(--muted);
  }

  .scope-no::before {
    content: "×";
    color: var(--haze);
  }

  .scope-yes {
    color: var(--ink);
    font-weight: 600;
    border-top-color: var(--blue) !important;
    border-bottom: 1px solid var(--blue);
  }

  .scope-yes::before {
    content: "✓";
    color: var(--blue);
  }

  /* ---------- compatibility ---------- */

  .proof-badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.4em 1.1em;
    margin: 0.25rem 0 0;
    background: var(--card);
  }

  .tier-list {
    margin-top: 2.25rem;
    max-width: 46rem;
  }

  .tier {
    padding-block: 1.3rem;
    border-top: 1px solid var(--rule);
  }

  .tier:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .tier-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .tier-claim {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.08rem;
    margin: 0 0 0.35rem;
    color: var(--ink);
  }

  .tier p:not(.tier-claim) {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 56ch;
  }

  /* ---------- test wall ---------- */

  .testwall {
    --focus: var(--biolume);
    background: var(--ink-deep);
    padding-block: 2.75rem 2.25rem;
    overflow: hidden;
  }

  .testwall-rows {
    display: grid;
    gap: 0.85rem;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .testwall-row {
    /* clip, not hidden: focus must never scroll the row and desync the loop */
    overflow: clip;
  }

  .testwall-track {
    display: flex;
    width: max-content;
  }

  .testwall-set {
    display: flex;
    gap: 0.7rem;
    padding-right: 0.7rem;
  }

  .testwall-chip {
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.4;
    white-space: nowrap;
    text-decoration: none;
    color: var(--haze-lit);
    border: 1px solid rgba(219, 228, 242, 0.13);
    border-radius: 999px;
    padding: 0.38em 1em;
    background: rgba(23, 48, 74, 0.3);
    transition: color 120ms ease, border-color 120ms ease, background-color 120ms ease;
  }

  .testwall-chip:hover,
  .testwall-chip:focus-visible {
    color: #ffffff;
    border-color: var(--tide-lit);
    background: rgba(37, 99, 235, 0.22);
  }

  .testwall-row:nth-child(2) .testwall-chip {
    color: var(--text-on-ink);
  }

  .testwall-note {
    margin: 1.75rem 0 0;
    font-size: 0.88rem;
    color: var(--muted-on-ink);
    max-width: 62ch;
  }

  .testwall-note a {
    color: var(--tide-lit);
  }

  @media (prefers-reduced-motion: no-preference) {
    .testwall-track {
      animation: wall-scroll var(--dur, 100s) linear infinite;
    }

    .testwall-row-reverse .testwall-track {
      animation-direction: reverse;
    }

    /* Links need to hold still while being aimed at or tabbed through. */
    .testwall-row:hover .testwall-track,
    .testwall-row:focus-within .testwall-track {
      animation-play-state: paused;
    }

    @keyframes wall-scroll {
      to {
        transform: translateX(-50%);
      }
    }
  }

  /* ---------- console ---------- */

  .console {
    background: var(--ink-deep);
    color: var(--text-on-ink);
  }

  .console h2 {
    color: #ffffff;
  }

  .console .section-lead {
    color: var(--muted-on-ink);
  }

  .shot {
    margin: 0;
    min-width: 0;
  }

  .shot-main {
    margin-top: 2.75rem;
  }

  .shot-frame {
    border: 1px solid var(--mist-dark);
    border-radius: 10px;
    overflow: hidden;
    background: var(--abyss);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 1px 2px rgba(9, 18, 36, 0.35),
      0 22px 60px rgba(9, 18, 36, 0.5);
  }

  .shot-chrome {
    display: flex;
    align-items: center;
    gap: 0.48rem;
    height: 2.5rem;
    padding: 0 1rem;
    border-bottom: 1px solid rgba(219, 228, 242, 0.16);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02)),
      rgba(12, 29, 49, 0.92);
  }

  .shot-chrome span {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: var(--coral-lit);
    box-shadow:
      inset 0 0 0 1px rgba(8, 22, 37, 0.24),
      0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .shot-chrome span:nth-child(2) {
    background: var(--gold-lit);
  }

  .shot-chrome span:nth-child(3) {
    background: var(--kelp-lit);
  }

  .shot-chrome strong {
    margin-inline: auto;
    color: var(--muted-on-ink);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .shot figcaption {
    margin-top: 0.85rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted-on-ink);
    max-width: 72ch;
  }

  .shot-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tide-lit);
    margin-right: 0.65rem;
  }

  .console-details {
    margin-top: 2.25rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem;
  }

  .console-details .shot {
    display: flex;
    flex-direction: column;
  }

  .console-details .shot-frame {
    flex: 1;
  }

  /* Hand-drawn console mocks. Everything inside a .mock is sized in em off
     one clamp so the whole drawing scales with the viewport, like the hero
     terminal. */
  .mock {
    font-size: clamp(0.55rem, 0.72vw, 0.82rem);
    line-height: 1.45;
    color: var(--haze-lit);
  }

  .mock-stacks {
    display: grid;
    grid-template-columns: 11.5em minmax(0, 1fr);
  }

  .mock-side {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    padding: 1.1em 0.9em;
    border-right: 1px solid rgba(219, 228, 242, 0.1);
    background: rgba(12, 29, 49, 0.55);
  }

  .mock-logo {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05em;
    color: #ffffff;
    padding: 0 0.7em;
    margin-bottom: 0.9em;
  }

  .mock-nav {
    font-size: 0.92em;
    padding: 0.42em 0.78em;
    border-radius: 6px;
  }

  .mock-nav.is-active {
    background: rgba(37, 99, 235, 0.24);
    color: #ffffff;
  }

  .mock-nav-label {
    margin-top: 1em;
    padding: 0 0.9em;
    font-family: var(--mono);
    font-size: 0.62em;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(147, 170, 198, 0.6);
  }

  .mock-main {
    min-width: 0;
    padding: 1.2em 1.4em 1.4em;
  }

  .mock-head {
    display: flex;
    align-items: baseline;
    gap: 1em;
  }

  .mock-title {
    font-family: var(--display);
    font-weight: 650;
    font-size: 1.5em;
    color: #ffffff;
  }

  .mock-sub {
    font-size: 0.9em;
  }

  .mock-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9em;
    margin: 1em 0 1.1em;
  }

  .mock-stat {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    padding: 0.7em 1em;
    border: 1px solid rgba(219, 228, 242, 0.1);
    border-radius: 8px;
    background: rgba(23, 48, 74, 0.35);
  }

  .mock-stat span {
    font-size: 0.78em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mock-stat strong {
    font-family: var(--mono);
    font-size: 1.35em;
    font-weight: 700;
    color: #ffffff;
  }

  .mock-table {
    border: 1px solid rgba(219, 228, 242, 0.1);
    border-radius: 8px;
    overflow: hidden;
  }

  .mock-panel .mock-table {
    border: 0;
    border-radius: 0;
  }

  .mock-row {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.7fr) 6em 5.6em;
    gap: 1em;
    align-items: center;
    padding: 0.52em 1.1em;
    border-top: 1px solid rgba(219, 228, 242, 0.07);
  }

  .mock-row:first-child {
    border-top: 0;
  }

  .mock-row > span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mock-row-head {
    background: rgba(12, 29, 49, 0.75);
  }

  .mock-row-head > span {
    font-family: var(--mono);
    font-size: 0.68em;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(147, 170, 198, 0.75);
  }

  .mock-row-project {
    background: rgba(23, 48, 74, 0.3);
  }

  .mock-row-project > span:first-child {
    color: #ffffff;
    font-weight: 600;
  }

  .mock-row-project > span:not(:first-child) {
    font-size: 0.82em;
  }

  .mock-row .num {
    font-family: var(--mono);
    text-align: right;
  }

  .mock-row .mono {
    font-family: var(--mono);
    font-size: 0.88em;
  }

  .mchip {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.66em;
    font-weight: 600;
    line-height: 1.5;
    padding: 0.18em 0.85em;
    border-radius: 999px;
    vertical-align: 0.14em;
  }

  .mchip-ok {
    color: var(--kelp-lit);
    background: rgba(52, 217, 162, 0.12);
  }

  .mchip-idle {
    color: var(--haze-lit);
    background: rgba(147, 170, 198, 0.14);
  }

  .mchip-run {
    color: var(--gold-lit);
    background: rgba(242, 180, 87, 0.14);
  }

  .mchip-diff {
    color: var(--biolume);
    background: rgba(63, 211, 232, 0.1);
  }

  /* detail panels */

  .mock-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
    padding: 0.75em 1.1em;
    border-bottom: 1px solid rgba(219, 228, 242, 0.1);
    background: rgba(12, 29, 49, 0.75);
  }

  .mock-crumb {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
    color: #ffffff;
  }

  .mock-tabs,
  .mock-toggle {
    display: flex;
    gap: 0.2em;
    flex-shrink: 0;
    font-size: 0.85em;
  }

  .mock-tabs span,
  .mock-toggle span {
    padding: 0.3em 0.85em;
    border-radius: 6px;
  }

  .mock-tabs .is-active,
  .mock-toggle .is-active {
    background: rgba(37, 99, 235, 0.24);
    color: #ffffff;
  }

  .mock-toolbar {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.7em 1.1em;
  }

  .mock-toolbar .mock-toggle {
    margin-left: auto;
  }

  .mock-search,
  .mock-select {
    font-size: 0.85em;
    padding: 0.35em 0.9em;
    border: 1px solid rgba(219, 228, 242, 0.12);
    border-radius: 6px;
    background: rgba(12, 29, 49, 0.6);
    color: rgba(147, 170, 198, 0.75);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mock-search {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 18em;
  }

  .mock-row-res {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) 4.5em;
  }

  .mock-row-act {
    grid-template-columns: 2.4em 6em minmax(0, 1fr) 4.6em 4em;
    gap: 0.8em;
  }

  .mock-row-act > span:nth-child(4) {
    font-size: 0.85em;
  }

  /* ---------- access control ---------- */

  .access-grid {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.25rem;
  }

  .access-card {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 1.5rem 1.5rem 0.75rem;
  }

  .access-card p {
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* ---------- operations ---------- */

  .ops-list {
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 0 3rem;
  }

  .ops-item {
    border-top: 1px solid var(--rule);
    padding-block: 1.4rem;
  }

  .ops-item dt {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .ops-item dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 52ch;
  }

  /* ---------- export ---------- */

  .lockin {
    background: var(--ink-deep);
    color: var(--text-on-ink);
    padding-block: 4.5rem;
  }

  .lockin h2 {
    color: #ffffff;
  }

  .lockin-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: center;
  }

  .terminal-tall {
    font-size: 0.82rem;
  }

  /* ---------- security ---------- */

  .security-grid {
