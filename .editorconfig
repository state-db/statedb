root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces on a markdown line is a hard line break — don't strip them.
trim_trailing_whitespace = false

[*.go]
indent_style = tab

[Makefile]
indent_style = tab
